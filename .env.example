# Copy to .env next to docker-compose.yml. Everything is optional: without it the app runs with
# placeholder Stripe values, which is enough to browse the demo but not to pay.

SQL_SA_PASSWORD=LocalDev_Passw0rd!

# Stripe test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:8080/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# A test-mode Connect account that receives the demo sellers' payouts
DEMO_SELLER_STRIPE_ACCOUNT_ID=acct_...
