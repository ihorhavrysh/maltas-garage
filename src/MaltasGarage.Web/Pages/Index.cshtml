@page
@model IndexModel
@{
    ViewData["Title"]       = "Buy & Sell Second Hand in Malta";
    ViewData["Description"] = "Malta's Garage is Malta's online marketplace for second-hand items. Buy and sell used goods safely with escrow payments, auctions, and MaltaPost delivery.";
    ViewData["Canonical"]   = Site.BaseUrl;
    ViewData["JsonLd"]      = $@"{{
  ""@context"": ""https://schema.org"",
  ""@graph"": [
    {{
      ""@type"": ""Organization"",
      ""name"": ""Malta's Garage"",
      ""url"": ""{Site.BaseUrl}"",
      ""logo"": ""{Site.BaseUrl}/favicon.svg""
    }},
    {{
      ""@type"": ""WebSite"",
      ""name"": ""Malta's Garage"",
      ""url"": ""{Site.BaseUrl}"",
      ""potentialAction"": {{
        ""@type"": ""SearchAction"",
        ""target"": {{
          ""@type"": ""EntryPoint"",
          ""urlTemplate"": ""{Site.BaseUrl}/Listings?q={{search_term_string}}""
        }},
        ""query-input"": ""required name=search_term_string""
      }}
    }}
  ]
}}";
}

@{
    ViewData["HideHeaderSearch"] = true;
    var tones = new[] { "tone-coral", "tone-sea", "tone-sun", "tone-green" };
    var popular = Model.Categories.Where(c => c.ListingCount > 0).OrderByDescending(c => c.ListingCount).Take(4).ToList();
}

<section class="hero">
    <div class="container">
        <div class="hero-grid">
            <div>
                <span class="hero-eyebrow"><i class="bi bi-geo-alt" aria-hidden="true"></i>Second-hand marketplace for Malta &amp; Gozo</span>
                <h1 class="hero-title">Pre-loved finds, <em>fair prices</em>, just round the corner.</h1>
                <p class="hero-lead">Buy it now, make an offer or join a live auction. Your payment stays in escrow until the item is in your hands.</p>
                <form class="hero-search" role="search" action="/Listings" method="get">
                    <label class="visually-hidden" for="homeSearchInput">What are you looking for?</label>
                    <input id="homeSearchInput" class="form-control" type="search" name="q" placeholder="Search for anything" autocomplete="off">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i>Search</button>
                </form>
                @if (popular.Any())
                {
                    <div class="hero-links">
                        <span>Popular:</span>
                        @foreach (var category in popular)
                        {
                            <a href="/Category/@category.Slug">@category.Name</a>
                        }
                    </div>
                }
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a class="btn btn-outline-primary" href="/Listings/Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>Sell an item</a>
                    <a class="btn btn-ghost" href="/HowItWorks">How it works <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <div class="hero-art">
                <img src="/images/Hero/hero.svg" alt="Illustration of a Maltese street market with limestone houses, coloured balconies and a church dome by the sea" fetchpriority="high">
            </div>
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Browse categories</h2>
                <p>Find what you need, or list what you are clearing out</p>
            </div>
            <a class="section-link" href="/Categories">All categories <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="category-grid">
            @for (var i = 0; i < Model.Categories.Count; i++)
            {
                var category = Model.Categories[i];
                var icon = string.IsNullOrEmpty(category.IconClass) ? "bi bi-box"
                    : category.IconClass.Contains(' ') ? category.IconClass : "bi " + category.IconClass;
                var count = category.ListingCount switch
                {
                    0 => "Coming soon",
                    1 => "1 item",
                    var n => $"{n} items"
                };
                <a class="category-card" href="/Category/@category.Slug">
                    <span class="category-icon @tones[i % tones.Length]"><i class="@icon" aria-hidden="true"></i></span>
                    <span>
                        <span class="category-name d-block">@category.Name</span>
                        <span class="category-count @(category.ListingCount == 0 ? "is-empty" : "")">@count</span>
                    </span>
                </a>
            }
        </div>
    </div>
</section>

@if (Model.EndingSoon.Any())
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-head">
                <div>
                    <h2><i class="bi bi-fire text-urgent" aria-hidden="true"></i> Ending soon</h2>
                    <p>Live auctions closing next</p>
                </div>
                <a class="section-link" href="/Listings?sort=ending">See all auctions <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="listing-grid cols-4">
                @foreach (var listing in Model.EndingSoon)
                {
                    <partial name="_ListingCard" model="listing" />
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>How Malta's Garage works</h2>
                <p>Safe for buyers, simple for sellers</p>
            </div>
            <a class="section-link" href="/HowItWorks">Read the full guide <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>

        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="buyer-tab-btn" data-bs-toggle="tab" data-bs-target="#buyer-tab" type="button" role="tab" aria-controls="buyer-tab" aria-selected="true">
                    <i class="bi bi-cart me-2" aria-hidden="true"></i>I'm a buyer
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="seller-tab-btn" data-bs-toggle="tab" data-bs-target="#seller-tab" type="button" role="tab" aria-controls="seller-tab" aria-selected="false">
                    <i class="bi bi-tag me-2" aria-hidden="true"></i>I'm a seller
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="buyer-tab" role="tabpanel" aria-labelledby="buyer-tab-btn">
                <div class="steps">
                    <div class="step">
                        <span class="step-num">1</span>
                        <span class="step-icon category-icon tone-sea"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <h3>Find something good</h3>
                        <p>Search or browse by category. Every listing shows its pickup town.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">2</span>
                        <span class="step-icon category-icon tone-sun"><i class="bi bi-hammer" aria-hidden="true"></i></span>
                        <h3>Buy, offer or bid</h3>
                        <p>Buy now at the fixed price, send the seller an offer, bundle items, or join the live auction.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">3</span>
                        <span class="step-icon category-icon tone-green"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                        <h3>Pay into escrow</h3>
                        <p>Pay by card with Stripe. The seller is paid only after you confirm you have the item.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">4</span>
                        <span class="step-icon category-icon tone-coral"><i class="bi bi-truck" aria-hidden="true"></i></span>
                        <h3>Receive and review</h3>
                        <p>MaltaPost tracked delivery, or meet up and confirm with a 6-digit handover code.</p>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="seller-tab" role="tabpanel" aria-labelledby="seller-tab-btn">
                <div class="steps">
                    <div class="step">
                        <span class="step-num">1</span>
                        <span class="step-icon category-icon tone-sea"><i class="bi bi-camera" aria-hidden="true"></i></span>
                        <h3>List your item</h3>
                        <p>Add photos, set a buy-now price, a starting price and the date it must go by.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">2</span>
                        <span class="step-icon category-icon tone-sun"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span>
                        <h3>Get buyers</h3>
                        <p>Buyers purchase instantly, make offers or bundles, and bid in the final auction week.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">3</span>
                        <span class="step-icon category-icon tone-green"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                        <h3>Ship or meet</h3>
                        <p>Send it with MaltaPost or hand it over in person with the buyer's code.</p>
                    </div>
                    <div class="step">
                        <span class="step-num">4</span>
                        <span class="step-icon category-icon tone-coral"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
                        <h3>Get paid</h3>
                        <p>The escrow is released to your Stripe account once the buyer confirms.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="section-head">
            <div>
                <h2>Just listed</h2>
                <p>Fresh from sellers across the islands</p>
            </div>
            <a class="section-link" href="/Listings">Browse all <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
        @if (Model.JustListed.Any())
        {
            <div class="listing-grid cols-4">
                @foreach (var listing in Model.JustListed)
                {
                    <partial name="_ListingCard" model="listing" />
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></span>
                <h3>No listings yet</h3>
                <p>Be the first to list something.</p>
                <a href="/Listings/Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>Create listing</a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        initSearchAutocomplete(document.getElementById('homeSearchInput'));
    </script>
}
