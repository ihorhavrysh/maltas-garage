@page
@model MaltasGarage.Web.Pages.BidModel
@{
    ViewData["Title"] = "Place Bid";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <a href="/Listing/@Model.ListingId" class="text-muted small d-inline-flex align-items-center gap-1 mb-3">
                <i class="bi bi-arrow-left"></i> Back to listing
            </a>

            <h1 class="h3 fw-bold mb-4">Place Bid</h1>

            <div class="row g-4">
                <!-- Left: item summary + payment -->
                <div class="col-md-7">
                    <!-- Item -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(Model.ListingImageUrl))
                                {
                                    <img src="@Model.ListingImageUrl" class="rounded"
                                         style="width:72px;height:72px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                         style="width:72px;height:72px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                                <div>
                                    <div class="fw-semibold">@Model.ListingTitle</div>
                                    <small class="text-muted">Sold by @Model.SellerName</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment -->
                    <div class="card">
                        <div class="card-header"><h6 class="mb-0">Payment</h6></div>
                        <div class="card-body">
                            <div id="payment-element"></div>
                            <div id="payment-errors" class="text-danger small mt-2 d-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Right: bid summary + pay button -->
                <div class="col-md-5">
                    <div class="card sticky-top" style="top:100px;">
                        <div class="card-header"><h6 class="mb-0">Bid Summary</h6></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Your bid</strong>
                                <strong class="text-primary fs-5">€@Model.Amount.ToString("N0")</strong>
                            </div>

                            <button type="button" id="submit-payment" class="btn btn-warning fw-semibold btn-lg w-100">
                                <span id="button-text">
                                    <i class="bi bi-hammer me-2"></i>Place Bid
                                </span>
                                <span id="spinner" class="d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span>Processing...
                                </span>
                            </button>

                            <div class="mt-3 text-muted small">
                                <p class="mb-1"><i class="bi bi-shield-check me-1 text-success"></i>Your payment is held securely - nothing goes to the seller yet.</p>
                                <p class="mb-0"><i class="bi bi-arrow-counterclockwise me-1 text-primary"></i>If someone outbids you, you'll receive a full refund automatically. No action needed.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripe = Stripe('@Model.PublishableKey');
        const clientSecret = '@Model.ClientSecret';
        const listingId = '@Model.ListingId';
        const amount = '@Model.Amount';
        const returnUrl = `${window.location.origin}/BidComplete?listingId=${listingId}&amount=${amount}`;

        let elements;

        async function initialize() {
            elements = stripe.elements({ clientSecret });
            const paymentElement = elements.create('payment');
            paymentElement.mount('#payment-element');
        }

        async function handleSubmit() {
            const btn = document.getElementById('submit-payment');
            const btnText = document.getElementById('button-text');
            const spinner = document.getElementById('spinner');
            const errorsDiv = document.getElementById('payment-errors');

            btn.disabled = true;
            btnText.classList.add('d-none');
            spinner.classList.remove('d-none');
            errorsDiv.classList.add('d-none');

            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: { return_url: returnUrl }
            });

            if (error) {
                errorsDiv.textContent = error.message;
                errorsDiv.classList.remove('d-none');
                btn.disabled = false;
                btnText.classList.remove('d-none');
                spinner.classList.add('d-none');
            }
        }

        document.getElementById('submit-payment').addEventListener('click', handleSubmit);
        initialize();
    </script>
}
