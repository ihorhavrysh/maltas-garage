@page
@model MaltasGarage.Web.Pages.Messages.IndexModel
@using MaltasGarage.Domain.Enums
@{
    ViewData["Title"] = "Messages";
    var threadOpen = Model.ShowSystem || Model.ActiveConversation != null;
    var unreadChats = Model.Conversations.Sum(c => c.UnreadCount);

    string Initials(string? name) => string.Concat((name ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    string DayLabel(DateTime d) => d.Date == DateTime.UtcNow.Date ? "Today"
        : d.Date == DateTime.UtcNow.Date.AddDays(-1) ? "Yesterday"
        : d.ToString("d MMM yyyy");
}

<div class="container py-4">
    <div class="d-none d-lg-flex justify-content-between align-items-end mb-3">
        <h1 class="mb-0">Messages</h1>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]</div>
    }

    <div class="inbox @(threadOpen ? "thread-open" : "")" style="height: min(780px, calc(100dvh - 190px)); min-height: 520px;">
        <div class="inbox-list">
            <div class="list-head">
                <ul class="nav nav-tabs border-0">
                    <li class="nav-item">
                        <a class="nav-link @(!Model.ShowSystem ? "active" : "")" href="/Messages" aria-current="@(!Model.ShowSystem ? "page" : null)">
                            Chats
                            @if (unreadChats > 0) { <span class="notif-badge position-static ms-1">@unreadChats</span> }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.ShowSystem ? "active" : "")" href="/Messages?system=true" aria-current="@(Model.ShowSystem ? "page" : null)">
                            Notifications
                            @if (Model.UnreadSystemCount > 0 && !Model.ShowSystem) { <span class="notif-badge position-static ms-1">@Model.UnreadSystemCount</span> }
                        </a>
                    </li>
                </ul>
            </div>

            <div class="overflow-auto flex-grow-1" style="min-height: 0;">
                <a class="convo @(Model.ShowSystem ? "active" : "") @(Model.UnreadSystemCount > 0 && !Model.ShowSystem ? "is-unread" : "")" href="/Messages?system=true">
                    <img class="avatar" src="~/images/logo-mark.svg" alt="">
                    <span class="convo-main">
                        <span class="convo-top"><span class="convo-name">Malta's Garage</span></span>
                        <span class="convo-preview d-block">System notifications</span>
                    </span>
                    @if (Model.UnreadSystemCount > 0 && !Model.ShowSystem)
                    {
                        <span class="unread-dot" aria-label="Unread"></span>
                    }
                </a>

                @if (!Model.Conversations.Any())
                {
                    <div class="empty-state py-4">
                        <p class="mb-0">No conversations yet. Make an offer on a listing to start one.</p>
                    </div>
                }
                @foreach (var conv in Model.Conversations)
                {
                    var unread = conv.UnreadCount > 0 && !conv.IsActive;
                    <a class="convo @(conv.IsActive ? "active" : "") @(unread ? "is-unread" : "")" href="/Messages?c=@conv.Id">
                        @if (!string.IsNullOrEmpty(conv.OtherPartyAvatarUrl))
                        {
                            <img class="avatar" src="@conv.OtherPartyAvatarUrl" alt="" style="object-fit:cover;">
                        }
                        else
                        {
                            <span class="avatar">@Initials(conv.OtherPartyName)</span>
                        }
                        <span class="convo-main">
                            <span class="convo-top">
                                <span class="convo-name">@conv.OtherPartyName</span>
                                <span class="convo-time">@conv.LastActivity.ToString("d MMM")</span>
                            </span>
                            <span class="convo-preview d-block">@(conv.LastMessage ?? "No messages yet")</span>
                        </span>
                        @if (unread)
                        {
                            <span class="unread-dot" aria-label="@conv.UnreadCount unread"></span>
                        }
                    </a>
                }
            </div>
        </div>

        <section class="thread" style="min-height: 0;" aria-label="Conversation">
            @if (Model.ShowSystem)
            {
                <div class="thread-head">
                    <a class="icon-btn d-lg-none" href="/Messages" aria-label="Back to conversations"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    <img class="avatar" src="~/images/logo-mark.svg" alt="">
                    <div class="flex-grow-1"><div class="fw-bold">System notifications</div></div>
                </div>
                <div class="thread-body" style="min-height: 0;">
                    @if (!Model.SystemMessages.Any())
                    {
                        <p class="text-muted text-center mt-4">No notifications yet.</p>
                    }
                    @foreach (var msg in Model.SystemMessages)
                    {
                        <div class="msg msg-in d-flex gap-2 align-items-start">
                            <i class="bi @GetSystemIcon(msg.Type) text-success" aria-hidden="true"></i>
                            <div class="flex-grow-1">
                                <div>@msg.Body</div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-1">
                                    <span class="msg-time">@msg.CreatedAt.ToString("d MMM yyyy, HH:mm")</span>
                                    @if (!string.IsNullOrEmpty(msg.Link))
                                    {
                                        <a href="@msg.Link" class="btn btn-secondary btn-sm">View</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Model.ActiveConversation != null)
            {
                var other = Model.ActiveConversation.BuyerId == Model.CurrentProfile!.Id
                    ? Model.ActiveConversation.Seller
                    : Model.ActiveConversation.Buyer;
                var iAmSeller = Model.ActiveConversation.SellerId == Model.CurrentProfile!.Id;
                var iAmBuyer = Model.ActiveConversation.BuyerId == Model.CurrentProfile!.Id;
                DateTime? lastDay = null;

                <div class="thread-head">
                    <a class="icon-btn d-lg-none" href="/Messages" aria-label="Back to conversations"><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
                    @if (!string.IsNullOrEmpty(other?.AvatarUrl))
                    {
                        <img class="avatar" src="@other.AvatarUrl" alt="" style="object-fit:cover;">
                    }
                    else
                    {
                        <span class="avatar">@Initials(other?.DisplayName)</span>
                    }
                    <div class="flex-grow-1">
                        <a class="fw-bold text-decoration-none" style="color: inherit" href="/Seller/@other?.Id">@(other?.DisplayName ?? "User")</a>
                        @if (other != null && other.TotalReviews > 0)
                        {
                            <div class="small text-muted"><partial name="_StarRating" model="@((other.Rating, other.TotalReviews))" /></div>
                        }
                    </div>
                </div>

                <div class="thread-body" id="chatMessages" style="min-height: 0;">
                    @foreach (var msg in Model.ActiveMessages)
                    {
                        if (lastDay != msg.CreatedAt.Date)
                        {
                            lastDay = msg.CreatedAt.Date;
                            <span class="day-sep">@DayLabel(msg.CreatedAt)</span>
                        }

                        if (msg.IsSystemNote && msg.OfferRef.HasValue && Model.OffersInThread.TryGetValue(msg.OfferRef.Value, out var offer))
                        {
                            var (offerClass, badgeClass, badgeText) = offer.Status switch
                            {
                                PriceOfferStatus.Pending => ("is-pending", "status-offer-pending", "Pending"),
                                PriceOfferStatus.Accepted => ("is-accepted", "status-offer-accepted", "Accepted"),
                                PriceOfferStatus.Completed => ("is-accepted", "status-offer-accepted", "Purchased"),
                                PriceOfferStatus.Rejected => ("is-rejected", "status-offer-rejected", "Declined"),
                                PriceOfferStatus.Expired => ("is-expired", "status-offer-expired", "Expired"),
                                _ => ("is-expired", "status-offer-expired", offer.Status.ToString())
                            };
                            var mine = msg.FromUserId == Model.CurrentProfile!.Id;
                            <div class="offer-card @offerClass @(mine ? "align-self-end" : "align-self-start")">
                                <div class="offer-head">
                                    <span class="d-flex align-items-center gap-2"><i class="bi bi-tag" aria-hidden="true"></i>Price offer</span>
                                    <span class="status-badge @badgeClass">@badgeText</span>
                                </div>
                                <div class="offer-body">
                                    <div>
                                        <a class="small text-muted text-decoration-none" href="/Listing/@offer.ListingId">@(offer.Listing?.Title ?? "Listing")</a>
                                        <div>
                                            <span class="offer-price">€@offer.Amount.ToString("N0")</span>
                                            @if (offer.Listing != null)
                                            {
                                                <span class="offer-was">€@offer.Listing.DesiredPrice.ToString("N0")</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @if (offer.Listing?.IsShowcase == true)
                                {
                                    <div class="offer-foot"><i class="bi bi-eye me-1" aria-hidden="true"></i>Showcase offer: accepting and declining are switched off in the demo.</div>
                                }
                                else if (offer.Status == PriceOfferStatus.Pending && iAmSeller)
                                {
                                    <div class="offer-actions">
                                        <form method="post" asp-page-handler="AcceptOffer" class="d-flex flex-fill">
                                            <input type="hidden" name="OfferId" value="@offer.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-check-lg" aria-hidden="true"></i>Accept</button>
                                        </form>
                                        <form method="post" asp-page-handler="RejectOffer" class="d-flex flex-fill">
                                            <input type="hidden" name="OfferId" value="@offer.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm flex-fill">Decline</button>
                                        </form>
                                    </div>
                                }
                                else if (offer.Status == PriceOfferStatus.Accepted && iAmBuyer && offer.Listing?.Status == ListingStatus.Active)
                                {
                                    <div class="offer-actions">
                                        <form method="post" asp-page="/Listing" asp-route-id="@offer.ListingId" asp-page-handler="BuyAtOfferPrice" class="d-flex flex-fill">
                                            <input type="hidden" name="offerId" value="@offer.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-cart3" aria-hidden="true"></i>Buy for €@offer.Amount.ToString("N0")</button>
                                        </form>
                                    </div>
                                }
                                <div class="offer-foot">
                                    @if (offer.Status == PriceOfferStatus.Pending)
                                    {
                                        @:Expires @offer.ExpiresAt.ToString("d MMM, HH:mm") UTC
                                    }
                                    else
                                    {
                                        @:Sent @msg.CreatedAt.ToString("d MMM, HH:mm")
                                    }
                                </div>
                            </div>
                        }
                        else if (msg.IsSystemNote && msg.BundleOfferRef.HasValue && Model.BundleOffersInThread.TryGetValue(msg.BundleOfferRef.Value, out var bundleOffer))
                        {
                            var (offerClass, badgeClass, badgeText) = bundleOffer.Status switch
                            {
                                BundleOfferStatus.Pending => ("is-pending", "status-offer-pending", "Pending"),
                                BundleOfferStatus.Accepted => ("is-accepted", "status-offer-accepted", "Accepted"),
                                BundleOfferStatus.Completed => ("is-accepted", "status-offer-accepted", "Purchased"),
                                BundleOfferStatus.Rejected => ("is-rejected", "status-offer-rejected", "Declined"),
                                BundleOfferStatus.Expired => ("is-expired", "status-offer-expired", "Expired"),
                                _ => ("is-expired", "status-offer-expired", "Cancelled")
                            };
                            var mine = msg.FromUserId == Model.CurrentProfile!.Id;
                            <div class="offer-card @offerClass @(mine ? "align-self-end" : "align-self-start")">
                                <div class="offer-head">
                                    <span class="d-flex align-items-center gap-2"><i class="bi bi-collection" aria-hidden="true"></i>Bundle offer · @bundleOffer.Items.Count items</span>
                                    <span class="status-badge @badgeClass">@badgeText</span>
                                </div>
                                <div class="offer-body d-block">
                                    <ul class="list-unstyled small mb-2">
                                        @foreach (var item in bundleOffer.Items.OrderBy(i => i.Listing.Title))
                                        {
                                            <li class="d-flex justify-content-between gap-2">
                                                <a class="text-decoration-none" href="/Listing/@item.ListingId">@item.Listing.Title</a>
                                                <span class="text-muted">€@item.ListedPrice.ToString("N0")</span>
                                            </li>
                                        }
                                    </ul>
                                    <span class="offer-price">€@bundleOffer.OfferAmount.ToString("N0")</span>
                                    <span class="offer-was">€@bundleOffer.TotalListedPrice.ToString("N0")</span>
                                </div>
                                @if (bundleOffer.Items.Any(i => i.Listing.IsShowcase))
                                {
                                    <div class="offer-foot"><i class="bi bi-eye me-1" aria-hidden="true"></i>Showcase offer: accepting and declining are switched off in the demo.</div>
                                }
                                else if (bundleOffer.Status == BundleOfferStatus.Pending && iAmSeller)
                                {
                                    <div class="offer-actions">
                                        <form method="post" asp-page-handler="AcceptBundleOffer" class="d-flex flex-fill">
                                            <input type="hidden" name="BundleOfferId" value="@bundleOffer.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-check-lg" aria-hidden="true"></i>Accept</button>
                                        </form>
                                        <form method="post" asp-page-handler="RejectBundleOffer" class="d-flex flex-fill">
                                            <input type="hidden" name="BundleOfferId" value="@bundleOffer.Id" />
                                            <button type="submit" class="btn btn-secondary btn-sm flex-fill">Decline</button>
                                        </form>
                                    </div>
                                }
                                else if (bundleOffer.Status == BundleOfferStatus.Accepted && iAmBuyer && bundleOffer.Items.All(i => i.Listing.Status == ListingStatus.Active))
                                {
                                    <div class="offer-actions">
                                        <a href="/BundleCheckout?bundleOfferId=@bundleOffer.Id" class="btn btn-primary btn-sm"><i class="bi bi-cart3" aria-hidden="true"></i>Complete purchase, €@bundleOffer.OfferAmount.ToString("N0")</a>
                                    </div>
                                }
                                <div class="offer-foot">
                                    @if (bundleOffer.Status == BundleOfferStatus.Pending)
                                    {
                                        @:Expires @bundleOffer.ExpiresAt.ToString("d MMM, HH:mm") UTC
                                    }
                                    else
                                    {
                                        @:Sent @msg.CreatedAt.ToString("d MMM, HH:mm")
                                    }
                                </div>
                            </div>
                        }
                        else if (msg.IsSystemNote && (msg.OfferRef.HasValue || msg.BundleOfferRef.HasValue))
                        {
                            <span class="msg-system">@(msg.BundleOfferRef.HasValue ? "Bundle offer" : "Offer")</span>
                        }
                        else if (msg.IsSystemNote)
                        {
                            <a class="msg-system text-decoration-none" href="/Orders/Details/@msg.OrderRef"><i class="bi bi-bag me-1" aria-hidden="true"></i>@msg.Body</a>
                        }
                        else
                        {
                            var isMine = msg.FromUserId == Model.CurrentProfile!.Id;
                            <div class="msg @(isMine ? "msg-out" : "msg-in")" style="word-break: break-word;">
                                <div>@msg.Body</div>
                                <div class="msg-time" style="@(isMine ? "color: rgba(255,255,255,.75)" : "")">@msg.CreatedAt.ToString("HH:mm")</div>
                            </div>
                        }
                    }
                    @if (!Model.ActiveMessages.Any())
                    {
                        <p class="text-muted text-center mt-4">No messages yet. Say hello!</p>
                    }
                </div>

                <form method="post" class="composer">
                    <input type="hidden" name="ConversationId" value="@Model.ActiveConversation.Id" />
                    <input type="hidden" name="FromOrder" value="@Model.PendingOrderRef" />
                    <label class="visually-hidden" for="messageBody">Message</label>
                    <input id="messageBody" type="text" name="Body" class="form-control" placeholder="Write a message..." maxlength="2000" autocomplete="off" required />
                    <button type="submit" class="btn btn-primary btn-icon" aria-label="Send"><i class="bi bi-send" aria-hidden="true"></i></button>
                </form>
            }
            else
            {
                <div class="empty-state flex-grow-1 d-flex flex-column align-items-center justify-content-center">
                    <span class="empty-icon"><i class="bi bi-chat-dots" aria-hidden="true"></i></span>
                    <p>Select a conversation to start messaging.</p>
                </div>
            }
        </section>
    </div>
</div>

@functions {
    string GetSystemIcon(SystemMessageType type) => type switch
    {
        SystemMessageType.BidOutbid              => "bi-arrow-up-circle",
        SystemMessageType.NewBidOnListing        => "bi-cash-coin",
        SystemMessageType.AuctionWon             => "bi-trophy",
        SystemMessageType.ItemPurchased          => "bi-bag-check",
        SystemMessageType.OrderShipped           => "bi-truck",
        SystemMessageType.EscrowReleased         => "bi-currency-euro",
        SystemMessageType.DisputeOpened          => "bi-exclamation-triangle",
        SystemMessageType.DisputeResolved        => "bi-shield-check",
        SystemMessageType.AuctionSold            => "bi-trophy-fill",
        SystemMessageType.AuctionExpired         => "bi-calendar-x",
        SystemMessageType.DeliveryMethodSelected => "bi-truck",
        SystemMessageType.OfferReceived          => "bi-tag",
        SystemMessageType.OfferAccepted          => "bi-check-circle",
        SystemMessageType.OfferRejected          => "bi-x-circle",
        _                                        => "bi-bell"
    };
}

@section Scripts {
    <script>
        const chat = document.getElementById('chatMessages');
        if (chat) chat.scrollTop = chat.scrollHeight;
    </script>
}
