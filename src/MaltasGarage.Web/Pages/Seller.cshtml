@page "{id:guid}"
@model MaltasGarage.Web.Pages.SellerModel
@using MaltasGarage.Domain.Enums
@{
    var sellerName     = Model.Seller?.DisplayName ?? "Seller";
    var sellerLocation = Model.Seller?.Location ?? "Malta";
    var sellerSales    = Model.Seller?.TotalSales ?? 0;
    var sellerRating   = Model.Seller?.Rating ?? 0m;
    var sellerReviews  = Model.Seller?.TotalReviews ?? 0;

    ViewData["Title"]       = $"{sellerName} - Second Hand Seller in Malta | Malta's Garage";
    ViewData["Description"] = $"Browse {sellerName}'s second-hand listings on Malta's Garage. {sellerSales} completed sales, {sellerRating:0.#}★ rating from {sellerReviews} reviews. Based in {sellerLocation}.";
    ViewData["Canonical"]   = Site.Absolute($"/Seller/{Model.Seller?.Id}");

    Func<string, string> J = s => System.Text.Json.JsonSerializer.Serialize(s);
    var personDesc = !string.IsNullOrEmpty(Model.Seller?.Bio)
        ? Model.Seller.Bio
        : $"Second-hand seller on Malta's Garage with {sellerSales} completed sales.";
    ViewData["JsonLd"] = $@"{{
  ""@context"": ""https://schema.org"",
  ""@type"": ""Person"",
  ""name"": {J(sellerName)},
  ""description"": {J(personDesc)},
  ""url"": ""{Site.BaseUrl}/Seller/{Model.Seller?.Id}"",
  ""memberOf"": {{
    ""@type"": ""Organization"",
    ""name"": ""Malta's Garage"",
    ""url"": ""{Site.BaseUrl}""
  }}
}}";
}

<div class="container py-5">
    <div class="row">
        <!-- Left: Seller Profile Card -->
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.Seller?.AvatarUrl))
                    {
                        <img src="@Model.Seller.AvatarUrl" alt="@Model.Seller.DisplayName"
                             class="rounded-circle mb-3" style="width: 100px; height: 100px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width: 100px; height: 100px;">
                            <i class="bi bi-person" style="font-size: 3rem;"></i>
                        </div>
                    }

                    <h4 class="mb-1">@Model.Seller?.DisplayName</h4>

                    @if (!string.IsNullOrEmpty(Model.Seller?.Location))
                    {
                        <p class="text-muted mb-2">
                            <i class="bi bi-geo-alt me-1"></i>@Model.Seller.Location
                        </p>
                    }

                    <p class="text-muted small mb-3">Member since @Model.Seller?.JoinedDate</p>

                    <!-- Star Rating -->
                    <div class="mb-3">
                        <partial name="_StarRating" model="@((Model.Seller?.Rating ?? 0, Model.Seller?.TotalReviews ?? 0))" />
                    </div>

                    <!-- Stats -->
                    <div class="d-flex justify-content-around border-top pt-3">
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.Seller?.TotalSales</div>
                            <small class="text-muted">Sales</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.ActiveListings</div>
                            <small class="text-muted">Active Listings</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold fs-5">@Model.Seller?.TotalReviews</div>
                            <small class="text-muted">Reviews</small>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Seller?.Bio))
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h6><i class="bi bi-person-lines-fill me-2"></i>About</h6>
                        <p class="mb-0 text-muted">@Model.Seller.Bio</p>
                    </div>
                </div>
            }

            @if (!Model.IsOwnProfile && Model.Listings.Count(l => l.Status == ListingStatus.Active) >= 2)
            {
                <div class="mt-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/BundleOffer/@Model.Seller!.Id" class="btn btn-outline-blue w-100">
                            <i class="bi bi-collection me-2"></i>Make a Bundle Offer
                        </a>
                    }
                    else
                    {
                        <a href="/Identity/Account/Login?returnUrl=@Uri.EscapeDataString(Request.Path)" class="btn btn-outline-blue w-100">
                            <i class="bi bi-collection me-2"></i>Make a Bundle Offer
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Right: Listings & Reviews Tabs -->
        <div class="col-lg-8">
            <ul class="nav nav-tabs mb-4" id="sellerTabs">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#listings-tab">
                        <i class="bi bi-grid me-1"></i>Listings (@Model.Listings.Count)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#reviews-tab">
                        <i class="bi bi-star me-1"></i>Reviews (@Model.Reviews.Count)
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Listings Tab -->
                <div class="tab-pane fade show active" id="listings-tab">
                    @if (Model.Listings.Any())
                    {
                        <div class="row g-3">
                            @foreach (var listing in Model.Listings)
                            {
                                var daysLeft = (listing.SellByDate - DateTime.UtcNow).Days;
                                var displayPrice = listing.Status == ListingStatus.AuctionPhase && listing.CurrentBid.HasValue
                                    ? listing.CurrentBid.Value
                                    : listing.Price;

                                <div class="col-sm-6 col-lg-4">
                                    <div class="card h-100 listing-card-hover position-relative">
                                        @if (!string.IsNullOrEmpty(listing.ImageUrl))
                                        {
                                            <img src="@listing.ImageUrl" alt="@listing.Title"
                                                 style="width:100%;height:180px;object-fit:cover;border-radius:var(--radius-lg) var(--radius-lg) 0 0;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center"
                                                 style="height:180px;border-radius:var(--radius-lg) var(--radius-lg) 0 0;">
                                                <i class="bi bi-image text-muted fs-1"></i>
                                            </div>
                                        }
                                        <div class="card-body p-3">
                                            @if (listing.Status == ListingStatus.AuctionPhase)
                                            {
                                                <span class="auction-badge-outline-fire mb-1">
                                                    <i class="bi bi-fire"></i> @daysLeft days left
                                                </span>
                                            }
                                            else if (listing.AuctionStartDate.HasValue && listing.AuctionStartDate > DateTime.UtcNow)
                                            {
                                                <span class="auction-badge-outline mb-1">
                                                    <i class="bi bi-calendar-event"></i>Auction starts @listing.AuctionStartDate.Value.ToString("dd MMM") · from €@listing.MinPrice.ToString("N0")
                                                </span>
                                            }
                                            else if (listing.AuctionStartDate == null)
                                            {
                                                <span class="auction-badge-outline-dark mb-1">
                                                    <i class="bi bi-calendar-x"></i>Fixed price · Expires @listing.SellByDate.ToString("dd MMM")
                                                </span>
                                            }
                                            else if (daysLeft <= 7)
                                            {
                                                <span class="auction-badge-outline-fire mb-1">
                                                    <i class="bi bi-fire"></i> @daysLeft days left
                                                </span>
                                            }

                                            <a href="/Listing/@listing.Id" class="text-decoration-none text-dark stretched-link">
                                                <div class="fw-semibold text-truncate">@listing.Title</div>
                                            </a>
                                            <div class="text-primary fw-bold">€@displayPrice.ToString("N0")</div>
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>@listing.PickupCity
                                                @if (!string.IsNullOrEmpty(listing.CategoryName))
                                                {
                                                    <span>· @listing.CategoryName</span>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2 mb-0">No active listings</p>
                        </div>
                    }
                </div>

                <!-- Reviews Tab -->
                <div class="tab-pane fade" id="reviews-tab">
                    @if (Model.Reviews.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="list-group-item px-2">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                            }
                                        </div>
                                        <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <p class="mb-1">@review.Comment</p>
                                    }
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>@review.FromUserName
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square fs-1"></i>
                            <p class="mt-2 mb-0">No reviews yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .listing-card-hover { transition: transform 0.15s, box-shadow 0.15s; }
    .listing-card-hover:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    #sellerTabs .nav-link { color: var(--color-text); }
    #sellerTabs .nav-link.active {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
        border-top-color: transparent;
        border-left-color: transparent;
        border-right-color: transparent;
    }
    #sellerTabs .nav-link:hover:not(.active) { color: var(--color-primary); }
</style>
