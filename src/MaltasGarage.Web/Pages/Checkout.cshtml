@page
@model MaltasGarage.Web.Pages.CheckoutModel
@inject Microsoft.Extensions.Options.IOptions<MaltasGarage.Application.Common.Models.StripeSettings> StripeSettings
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4">Checkout</h1>

            <div class="row">
                <!-- Left column: summary + delivery + payment -->
                <div class="col-md-7 mb-4">
                    <!-- Item Summary -->
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0">Order Summary</h6></div>
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(Model.Listing?.ImageUrl))
                                {
                                    <img src="@Model.Listing.ImageUrl" class="rounded me-3"
                                         style="width: 80px; height: 80px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                         style="width: 80px; height: 80px;">
                                        <i class="bi bi-image text-muted fs-4"></i>
                                    </div>
                                }
                                <div>
                                    <h6 class="mb-1">@Model.Listing?.Title</h6>
                                    <small class="text-muted">Sold by @Model.Listing?.SellerName</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Delivery Method -->
                    <div class="card mb-3">
                        <div class="card-header"><h6 class="mb-0">Delivery Method</h6></div>
                        <div class="card-body">
                            <div class="form-check mb-3 p-3 border rounded" style="cursor:pointer;">
                                <input class="form-check-input" type="radio" name="deliveryMethod"
                                       id="handToHand" value="HandToHand" checked>
                                <label class="form-check-label w-100" for="handToHand" style="cursor:pointer;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong><i class="bi bi-person-check me-2"></i>Hand-to-Hand</strong>
                                            <p class="text-muted small mb-0">Meet the seller in person. Confirm receipt on your order page.</p>
                                        </div>
                                        <span class="text-success fw-semibold flex-shrink-0 ms-2">Free</span>
                                    </div>
                                </label>
                            </div>
                            <div class="form-check mb-3 p-3 border rounded" style="cursor:pointer;">
                                <input class="form-check-input" type="radio" name="deliveryMethod"
                                       id="maltaPost" value="MaltaPost">
                                <label class="form-check-label w-100" for="maltaPost" style="cursor:pointer;">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong><i class="bi bi-truck me-2"></i>MaltaPost Delivery</strong>
                                            <p class="text-muted small mb-0">Seller ships with tracking. 2–5 business days.</p>
                                        </div>
                                        <span class="text-muted flex-shrink-0 ms-2">Billed by MaltaPost</span>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Stripe Payment Element -->
                    <div class="card">
                        <div class="card-header"><h6 class="mb-0">Payment</h6></div>
                        <div class="card-body">
                            <div id="payment-element"></div>
                            <div id="payment-errors" class="alert alert-danger mt-3 d-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Right column: price summary + pay button -->
                <div class="col-md-5">
                    <div class="card sticky-top" style="top: 100px;">
                        <div class="card-header"><h6 class="mb-0">Price Details</h6></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Item price</span>
                                <span>€@Model.Price.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Delivery</span>
                                <span id="deliveryPriceLabel" class="text-success">Free</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-4">
                                <strong>Total</strong>
                                <strong class="text-primary fs-4">€@Model.Price.ToString("N0")</strong>
                            </div>

                            <button type="button" id="submit-payment" class="btn btn-primary btn-lg w-100">
                                <span id="button-text">
                                    <i class="bi bi-lock me-2"></i>Pay €@Model.Price.ToString("N0")
                                </span>
                                <span id="spinner" class="d-none">
                                    <span class="spinner-border spinner-border-sm me-2"></span>Processing...
                                </span>
                            </button>

                            <div class="mt-3 text-muted small">
                                <p class="mb-1"><i class="bi bi-shield-check me-1 text-success"></i>Your payment is held securely - nothing goes to the seller yet.</p>
                                <p class="mb-0"><i class="bi bi-check-circle me-1 text-primary"></i>Funds are only released to the seller once you confirm you've received the item.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripe = Stripe('@StripeSettings.Value.PublishableKey');
        const clientSecret = '@Model.ClientSecret';
        const listingId = '@Model.ListingId';
        const price = '@Model.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)';
        const returnBase = window.location.origin + '/Orders/PaymentComplete';
        const offerId = '@(Model.OfferId?.ToString() ?? "")';

        let elements;

        async function initialize() {
            elements = stripe.elements({ clientSecret });
            const paymentElement = elements.create('payment');
            paymentElement.mount('#payment-element');
        }

        async function handleSubmit() {
            const btn = document.getElementById('submit-payment');
            const btnText = document.getElementById('button-text');
            const spinner = document.getElementById('spinner');
            const errorsDiv = document.getElementById('payment-errors');

            btn.disabled = true;
            btnText.classList.add('d-none');
            spinner.classList.remove('d-none');
            errorsDiv.classList.add('d-none');

            const deliveryMethod = document.querySelector('input[name="deliveryMethod"]:checked').value;
            const offerParam = offerId ? `&offerId=${offerId}` : '';
            const returnUrl = `${returnBase}?listingId=${listingId}&price=${price}&deliveryMethod=${deliveryMethod}${offerParam}`;

            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: { return_url: returnUrl }
            });

            if (error) {
                errorsDiv.textContent = error.message;
                errorsDiv.classList.remove('d-none');
                btn.disabled = false;
                btnText.classList.remove('d-none');
                spinner.classList.add('d-none');
            }
        }

        document.getElementById('submit-payment').addEventListener('click', handleSubmit);
        initialize();

        // Update delivery label in price summary when method changes
        document.querySelectorAll('input[name="deliveryMethod"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const label = document.getElementById('deliveryPriceLabel');
                if (this.value === 'MaltaPost') {
                    label.textContent = 'Billed by MaltaPost';
                    label.className = 'text-muted small';
                } else {
                    label.textContent = 'Free';
                    label.className = 'text-success';
                }
            });
        });
    </script>
}
