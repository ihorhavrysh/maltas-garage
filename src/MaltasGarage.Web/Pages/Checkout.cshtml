@page
@model MaltasGarage.Web.Pages.CheckoutModel
@inject Microsoft.Extensions.Options.IOptions<MaltasGarage.Application.Common.Models.StripeSettings> StripeSettings
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-4">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Listing/@Model.ListingId">@Model.Listing?.Title</a></li>
            <li class="breadcrumb-item active" aria-current="page">Checkout</li>
        </ol>
    </nav>
    <h1 class="mb-2">Checkout</h1>
    <ol class="checkout-steps list-unstyled">
        <li class="is-active">1. Delivery &amp; payment</li>
        <li><i class="bi bi-chevron-right" aria-hidden="true"></i></li>
        <li>2. Confirmation</li>
    </ol>

    <div class="checkout-layout">
        <div class="d-grid gap-3">
            <div class="info-card m-0">
                <h2>How do you want to get it?</h2>
                <div class="d-grid gap-2">
                    <label class="choice-card" for="handToHand">
                        <input class="form-check-input" type="radio" name="deliveryMethod" id="handToHand" value="HandToHand" checked>
                        <span class="flex-grow-1">
                            <strong class="d-block">Meet in person</strong>
                            <span class="small text-muted">Arrange a time in chat, check the item, then confirm receipt in the app to pay the seller.</span>
                        </span>
                        <strong>Free</strong>
                    </label>
                    <label class="choice-card" for="maltaPost">
                        <input class="form-check-input" type="radio" name="deliveryMethod" id="maltaPost" value="MaltaPost">
                        <span class="flex-grow-1">
                            <strong class="d-block">MaltaPost tracked delivery</strong>
                            <span class="small text-muted">The seller ships with tracking, 2 to 5 working days.</span>
                        </span>
                        <strong class="small text-muted">Billed by MaltaPost</strong>
                    </label>
                </div>
            </div>

            <div class="info-card m-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">Payment</h2>
                    <span class="small text-muted d-flex align-items-center gap-1"><i class="bi bi-lock" aria-hidden="true"></i>Secured by Stripe</span>
                </div>
                <div id="payment-element"></div>
                <div class="form-text mt-2">Test mode: use <code>4242 4242 4242 4242</code>, any future date and any CVC.</div>
                <div id="payment-errors" class="alert alert-danger mt-3 d-none"></div>
            </div>
        </div>

        <aside class="listing-aside">
            <div class="buy-panel">
                <h2 class="h3 mb-3">Order summary</h2>
                <div class="summary-item">
                    @if (!string.IsNullOrEmpty(Model.Listing?.ImageUrl))
                    {
                        <img src="@Model.Listing.ImageUrl" alt="">
                    }
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@Model.Listing?.Title</div>
                        <div class="small text-muted">Sold by @Model.Listing?.SellerName</div>
                    </div>
                </div>
                <hr class="panel-divider">
                <dl class="mb-0">
                    <div class="kv"><dt>Item price</dt><dd>€@Model.Price.ToString("N2")</dd></div>
                    <div class="kv"><dt>Delivery</dt><dd id="deliveryPriceLabel">Free</dd></div>
                </dl>
                <hr class="panel-divider">
                <div class="d-flex justify-content-between align-items-baseline">
                    <span class="fw-bold">Total</span>
                    <span class="summary-total">€@Model.Price.ToString("N2")</span>
                </div>
                <button type="button" id="submit-payment" class="btn btn-primary btn-lg w-100 mt-3">
                    <span id="button-text"><i class="bi bi-lock" aria-hidden="true"></i> Pay €@Model.Price.ToString("N2")</span>
                    <span id="spinner" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Processing...</span>
                </button>
                <div class="escrow-note mt-3">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>We hold your payment in escrow. The seller is paid only after you confirm you have the item. If something is wrong you can open a dispute.</span>
                </div>
            </div>
        </aside>
    </div>
</div>
@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripe = Stripe('@StripeSettings.Value.PublishableKey');
        const clientSecret = '@Model.ClientSecret';
        const listingId = '@Model.ListingId';
        const returnBase = window.location.origin + '/Orders/PaymentComplete';

        let elements;

        async function initialize() {
            elements = stripe.elements({ clientSecret });
            const paymentElement = elements.create('payment');
            paymentElement.mount('#payment-element');
        }

        async function handleSubmit() {
            const btn = document.getElementById('submit-payment');
            const btnText = document.getElementById('button-text');
            const spinner = document.getElementById('spinner');
            const errorsDiv = document.getElementById('payment-errors');

            btn.disabled = true;
            btnText.classList.add('d-none');
            spinner.classList.remove('d-none');
            errorsDiv.classList.add('d-none');

            const deliveryMethod = document.querySelector('input[name="deliveryMethod"]:checked').value;
            // Price and offer are read back from the Stripe payment, not from this URL
            const returnUrl = `${returnBase}?listingId=${listingId}&deliveryMethod=${deliveryMethod}`;

            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: { return_url: returnUrl }
            });

            if (error) {
                errorsDiv.textContent = error.message;
                errorsDiv.classList.remove('d-none');
                btn.disabled = false;
                btnText.classList.remove('d-none');
                spinner.classList.add('d-none');
            }
        }

        document.getElementById('submit-payment').addEventListener('click', handleSubmit);
        initialize();

        // Update delivery label in price summary when method changes
        document.querySelectorAll('input[name="deliveryMethod"]').forEach(radio => {
            radio.addEventListener('change', function () {
                const label = document.getElementById('deliveryPriceLabel');
                label.textContent = this.value === 'MaltaPost' ? 'Billed by MaltaPost' : 'Free';
            });
        });
    </script>
}
