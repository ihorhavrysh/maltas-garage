@page
@model MaltasGarage.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-5">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.Profile?.AvatarUrl))
                    {
                        <img src="@Model.Profile.AvatarUrl" alt="Avatar"
                             class="rounded-circle mb-3" style="width: 80px; height: 80px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                    <h6 class="mb-1">@(Model.Profile?.DisplayName ?? "User")</h6>
                    <small class="text-muted">Member since @Model.Profile?.CreatedAt.ToString("MMM yyyy")</small>
                </div>
            </div>

            <div class="list-group mt-3">
                <a href="/Account/Profile" class="list-group-item list-group-item-action">
                    <i class="bi bi-person me-2"></i>Profile
                </a>
                <a href="/Account/MyListings" class="list-group-item list-group-item-action">
                    <i class="bi bi-collection me-2"></i>My Listings
                </a>
                <a href="/Account/Sales" class="list-group-item list-group-item-action">
                    <i class="bi bi-graph-up me-2"></i>My Sales
                </a>
                <a href="/Orders" class="list-group-item list-group-item-action active">
                    <i class="bi bi-bag me-2"></i>My Orders
                </a>
                <a href="/Account/Favourites" class="list-group-item list-group-item-action">
                    <i class="bi bi-heart me-2"></i>Favourites
                </a>
                <a href="/Account/Settings" class="list-group-item list-group-item-action">
                    <i class="bi bi-gear me-2"></i>Settings
                </a>
            </div>
        </div>

        <!-- Main -->
        <div class="col-lg-9">
            <h4 class="mb-4 fw-bold">My Orders</h4>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.HasAnyOrders)
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-bag text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">No orders yet</h5>
                        <p class="text-muted">Start shopping to see your orders here.</p>
                        <a href="/" class="btn btn-primary">Browse Items</a>
                    </div>
                </div>
            }
            else
            {
                @if (Model.DisputedOrders.Any())
                {
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>Disputed (@Model.DisputedOrders.Count)
                    </h6>
                    <div class="card mb-4">
                        @foreach (var order in Model.DisputedOrders)
                        {
                            @await Html.PartialAsync("_OrderRow", order)
                        }
                    </div>
                }

                @if (Model.InProgressOrders.Any())
                {
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">
                        <i class="bi bi-hourglass-split me-1"></i>In Progress (@Model.InProgressOrders.Count)
                    </h6>
                    <div class="card mb-4">
                        @foreach (var order in Model.InProgressOrders)
                        {
                            @await Html.PartialAsync("_OrderRow", order)
                        }
                    </div>
                }

                @if (Model.CompletedOrders.Any())
                {
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">
                        <i class="bi bi-check-circle me-1 text-primary"></i>Completed (@Model.CompletedOrders.Count)
                    </h6>
                    <div class="card mb-4">
                        @foreach (var order in Model.CompletedOrders)
                        {
                            @await Html.PartialAsync("_OrderRow", order)
                        }
                    </div>
                }

                @if (Model.OtherOrders.Any())
                {
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Other (@Model.OtherOrders.Count)</h6>
                    <div class="card mb-4">
                        @foreach (var order in Model.OtherOrders)
                        {
                            @await Html.PartialAsync("_OrderRow", order)
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
