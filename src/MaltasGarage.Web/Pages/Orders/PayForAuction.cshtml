@page "{orderId:guid}"
@model MaltasGarage.Web.Pages.Orders.PayForAuctionModel
@{
    ViewData["Title"] = "Complete Your Purchase";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center mb-4">
                <i class="bi bi-trophy text-warning" style="font-size: 4rem;"></i>
                <h2 class="mt-3">You Won!</h2>
                <p class="lead text-muted">Complete your payment to secure the item.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.Order?.ImageUrl))
                        {
                            <img src="@Model.Order.ImageUrl" class="rounded me-3"
                                 style="width: 80px; height: 80px; object-fit: cover;" alt="@Model.Order.Title">
                        }
                        else
                        {
                            <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px;">
                                <i class="bi bi-image text-muted fs-4"></i>
                            </div>
                        }
                        <div>
                            <h5 class="mb-1">@Model.Order?.Title</h5>
                            <p class="text-muted small mb-0">Seller: @Model.Order?.SellerName</p>
                        </div>
                    </div>

                    <div class="bg-light rounded p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Your winning bid</span>
                            <strong class="text-primary fs-4">€@Model.Order?.FinalPrice.ToString("N0")</strong>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <i class="bi bi-clock me-2"></i>
                        Please complete payment within 24 hours to secure your purchase.
                    </div>

                    <a href="/Checkout?listingId=@Model.Order?.ListingId&price=@Model.Order?.FinalPrice&deliveryMethod=HandToHand"
                       class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-credit-card me-2"></i>Pay €@Model.Order?.FinalPrice.ToString("N0")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
