@page
@model MaltasGarage.Web.Pages.Listings.IndexModel
@using static MaltasGarage.Web.Pages.CategoryModel
@{
    if (!string.IsNullOrEmpty(Model.Q))
    {
        ViewData["Title"]       = $"Results for \"{Model.Q}\" - Second Hand Malta";
        ViewData["Description"] = $"Found {Model.TotalCount} second-hand items matching \"{Model.Q}\" in Malta. Browse listings on Malta's Garage.";
    }
    else if (Model.Sort == "ending")
    {
        ViewData["Title"]       = "Ending Soon - Second Hand Deals in Malta";
        ViewData["Description"] = "Browse second-hand items ending soon on Malta's Garage. Grab a deal before it's gone!";
    }
    else
    {
        ViewData["Title"]       = "Buy & Sell Second Hand Items in Malta";
        ViewData["Description"] = $"Browse {Model.TotalCount} second-hand listings on Malta's Garage - Malta's online marketplace for used goods.";
        ViewData["Canonical"]   = Site.Absolute("/Listings");
    }
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h1 class="mb-0 fw-bold">
                @if (!string.IsNullOrEmpty(Model.Q))
                {
                    <span>Results for "@Model.Q"</span>
                }
                else if (Model.Sort == "ending")
                {
                    <i class="bi bi-fire text-urgent me-2"></i><span>@ViewData["Title"]</span>
                }
                else
                {
                    <span>@ViewData["Title"]</span>
                }
            </h1>
            <p class="text-muted mb-0">@Model.TotalCount @(Model.TotalCount == 1 ? "item" : "items") found</p>
        </div>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            @{ var q = Model.Q != null ? $"&q={Uri.EscapeDataString(Model.Q)}" : ""; }
            @{ var cp = !string.IsNullOrEmpty(Model.Condition) ? $"&condition={Model.Condition}" : ""; }
            <a href="?sort=newest&pageNum=1@q@cp" class="btn btn-sm @(Model.Sort == "newest" ? "btn-primary" : "btn-outline-secondary")">Newest</a>
            <a href="?sort=ending&pageNum=1@q@cp" class="btn btn-sm @(Model.Sort == "ending" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-fire me-1"></i>Ending Soon
            </a>
            <a href="?sort=price-asc&pageNum=1@q@cp" class="btn btn-sm @(Model.Sort == "price-asc" ? "btn-primary" : "btn-outline-secondary")">Price ↑</a>
            <a href="?sort=price-desc&pageNum=1@q@cp" class="btn btn-sm @(Model.Sort == "price-desc" ? "btn-primary" : "btn-outline-secondary")">Price ↓</a>
            <form method="get" class="d-flex align-items-center gap-1 ms-1">
                @if (!string.IsNullOrEmpty(Model.Q)) { <input type="hidden" name="q" value="@Model.Q" /> }
                <input type="hidden" name="sort" value="@Model.Sort" />
                <select name="condition" class="form-select form-select-sm @(!string.IsNullOrEmpty(Model.Condition) ? "border-primary" : "")" style="width:auto;" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Condition))">All</option>
                    <option value="new" selected="@(Model.Condition == "new")">New</option>
                    <option value="used" selected="@(Model.Condition == "used")">Used</option>
                </select>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Q))
    {
        <form action="/Listings" method="get" class="mb-4" style="max-width:400px;">
            <div class="input-group">
                <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Search listings..." />
                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
    }

    @if (Model.Listings.Any())
    {
        <div class="row g-4">
            @foreach (var listing in Model.Listings)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ListingCard" model="listing" />
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            var p = Model.CurrentPage;
            var tp = Model.TotalPages;
            var s = Model.Sort;
            var qp = Model.Q != null ? $"&q={Uri.EscapeDataString(Model.Q)}" : "";
            var nop = !string.IsNullOrEmpty(Model.Condition) ? $"&condition={Model.Condition}" : "";
            <nav class="mt-4">
                <ul class="pagination justify-content-center flex-wrap">
                    @* Prev *@
                    <li class="page-item @(p == 1 ? "disabled" : "")">
                        <a class="page-link" href="?sort=@s@qp@nop&pageNum=@(p - 1)"><i class="bi bi-chevron-left"></i></a>
                    </li>

                    @* First *@
                    @if (p > 3)
                    {
                        <li class="page-item"><a class="page-link" href="?sort=@s@qp@nop&pageNum=1">1</a></li>
                        @if (p > 4) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    }

                    @* Window: current ± 2 *@
                    @for (int i = Math.Max(1, p - 2); i <= Math.Min(tp, p + 2); i++)
                    {
                        <li class="page-item @(i == p ? "active" : "")">
                            <a class="page-link" href="?sort=@s@qp@nop&pageNum=@i">@i</a>
                        </li>
                    }

                    @* Last *@
                    @if (p < tp - 2)
                    {
                        @if (p < tp - 3) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                        <li class="page-item"><a class="page-link" href="?sort=@s@qp@nop&pageNum=@tp">@tp</a></li>
                    }

                    @* Next *@
                    <li class="page-item @(p == tp ? "disabled" : "")">
                        <a class="page-link" href="?sort=@s@qp@nop&pageNum=@(p + 1)"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3">No listings found</h4>
            <a href="/Listings/Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Create Listing
            </a>
        </div>
    }
</div>
