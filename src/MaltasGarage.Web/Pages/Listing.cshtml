@page "{id:guid}"
@model MaltasGarage.Web.Pages.ListingModel
@using MaltasGarage.Domain.Enums
@{
    var listingTitle = Model.Listing?.Title ?? "Listing";
    var listingPrice = Model.Listing?.DesiredPrice.ToString("N0") ?? "0";
    var categoryName = Model.Listing?.Category?.Name ?? "Items";

    ViewData["Title"]       = $"{listingTitle} - {categoryName} in Malta";
    ViewData["Description"] = Model.MetaDescription;
    ViewData["Canonical"]   = Site.Absolute($"/Listing/{Model.Listing?.Id}");
    ViewData["OgType"]      = "og:product";
    ViewData["OgTitle"]     = $"{listingTitle} - €{listingPrice} | Malta's Garage";
    ViewData["OgImage"]     = Model.PrimaryImageUrl != null ? Site.Absolute(Model.PrimaryImageUrl) : null;
    ViewData["JsonLd"]      = Model.JsonLd;

    var listing = Model.Listing!;
    var now = DateTime.UtcNow;
    var isAuction = listing.Status == ListingStatus.AuctionPhase;
    var isActive = listing.Status == ListingStatus.Active;
    var isAvailable = isActive || isAuction;
    var isShowcase = listing.IsShowcase;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var remaining = listing.SellByDate - now;
    var loginUrl = $"/Identity/Account/Login?returnUrl={Uri.EscapeDataString($"/Listing/{listing.Id}")}";
    var images = listing.Images.OrderBy(i => i.SortOrder).ToList();
    var condition = listing.IsNew ? "New" : "Used";
    var seller = listing.Seller;
    var sellerName = seller?.DisplayName ?? "Seller";
    var sellerInitials = string.Concat(sellerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    string statusClass, statusText;
    if (listing.Status == ListingStatus.Sold) { statusClass = "status-sold"; statusText = "Sold"; }
    else if (!isAvailable) { statusClass = "status-expired"; statusText = "No longer available"; }
    else if (isShowcase) { statusClass = "status-showcase"; statusText = "Showcase"; }
    else if (isAuction && remaining.TotalHours <= 24) { statusClass = "status-ending"; statusText = remaining.TotalHours >= 1 ? $"Ends in {(int)remaining.TotalHours}h" : "Ending soon"; }
    else if (isAuction) { statusClass = "status-live"; statusText = $"Live · {(int)remaining.TotalDays}d {remaining.Hours}h"; }
    else if (listing.AuctionStartDate > now) { statusClass = "status-scheduled"; statusText = $"Auction {listing.AuctionStartDate:d MMM} · from €{listing.MinPrice:N0}"; }
    else { statusClass = "status-buynow"; statusText = "Buy now only"; }

    var currentBid = Model.CurrentBid ?? listing.MinPrice;
    var increment = (int)MaltasGarage.Infrastructure.Services.BiddingService.GetBidIncrement(currentBid);
    var minNextBid = (int)currentBid + increment;
    var canTransact = !Model.IsOwner && !isShowcase && !(isSignedIn && !Model.HasProfile) && seller?.StripeOnboardingComplete == true;
}

<div class="container py-4">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Category/@listing.Category?.Slug">@listing.Category?.Name</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 240px;">@listing.Title</li>
        </ol>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div>
    }

    <div class="listing-layout">
        @* Order matters: gallery, aside, details, so the buy panel sits under the photos on mobile *@
        <div class="listing-gallery">
            <div class="gallery-main">
                @if (images.Any())
                {
                    <img id="mainImage" src="@images.First().Url" alt="Photo of @listing.Title">
                }
                else
                {
                    <div class="d-flex h-100 align-items-center justify-content-center text-muted"><i class="bi bi-image" style="font-size:4rem;" aria-hidden="true"></i></div>
                }
                <div class="card-badges">
                    <span class="status-badge @statusClass">
                        @if (statusClass == "status-live") { <span class="pulse"></span> }
                        @statusText
                    </span>
                    @if (listing.IsNew)
                    {
                        <span class="status-badge status-new"><i class="bi bi-stars" aria-hidden="true"></i>New</span>
                    }
                </div>
                @if (!Model.IsOwner)
                {
                    <button id="favBtn" class="fav-btn @(Model.IsFavourited ? "is-active" : "")" type="button"
                            style="position:absolute; top:1rem; right:1rem; width:44px; height:44px; border-radius:50%; border:0; background:#fff; box-shadow:0 1px 2px rgba(38,34,29,.1)"
                            data-listing-id="@listing.Id"
                            data-authenticated="@(isSignedIn ? "true" : "false")"
                            data-login-url="@loginUrl"
                            aria-label="@(Model.IsFavourited ? "Remove from favourites" : "Save to favourites")">
                        <i class="bi bi-heart@(Model.IsFavourited ? "-fill" : "") fs-5" aria-hidden="true"></i>
                    </button>
                }
            </div>
            @if (images.Count > 1)
            {
                <div class="gallery-thumbs" id="thumbnailStrip">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <button class="gallery-thumb @(i == 0 ? "active" : "")" type="button" data-full="@images[i].Url"
                                onclick="goToImage(@i)" aria-label="Photo @(i + 1) of @images.Count">
                            <img src="@(images[i].ThumbnailUrl ?? images[i].Url)" alt="">
                        </button>
                    }
                </div>
            }
        </div>

        <aside class="listing-aside">
            <h1 class="listing-title">@listing.Title</h1>
            <div class="listing-facts mb-3">
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i>@(listing.PickupCity ?? "Malta")</span>
                <span><i class="bi bi-check-circle" aria-hidden="true"></i>@condition</span>
                @if (listing.PublishedAt != null)
                {
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i>Listed @listing.PublishedAt.Value.ToString("d MMM yyyy")</span>
                }
            </div>

            <div class="buy-panel">
                @if (isAuction)
                {
                    <div class="auction-panel">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="price-block">
                                <div class="label">@(Model.BidCount > 0 ? "Current bid" : "Starting bid")</div>
                                <div class="amount tabular">€@currentBid.ToString("N0")</div>
                                <div class="sub" style="color:#CFC6B8">
                                    @Model.BidCount @(Model.BidCount == 1 ? "bid" : "bids")@(Model.IsTopBidder ? " · you are the highest bidder" : "")
                                </div>
                            </div>
                            <span class="status-badge @(statusClass == "status-ending" ? "status-ending" : "status-live")">
                                @if (statusClass != "status-ending") { <span class="pulse"></span> }Live
                            </span>
                        </div>

                        <div class="countdown" role="timer" aria-live="off" aria-label="Time left"
                             data-ends-at="@DateTime.SpecifyKind(listing.SellByDate, DateTimeKind.Utc).ToString("o")">
                            <div class="countdown-unit"><strong data-unit="d">@((int)remaining.TotalDays)</strong><span>days</span></div>
                            <div class="countdown-unit"><strong data-unit="h">@remaining.Hours.ToString("00")</strong><span>hours</span></div>
                            <div class="countdown-unit"><strong data-unit="m">@remaining.Minutes.ToString("00")</strong><span>min</span></div>
                            <div class="countdown-unit"><strong data-unit="s">@remaining.Seconds.ToString("00")</strong><span>sec</span></div>
                        </div>
                        <div class="small mb-2" style="color:#CFC6B8">Ends @listing.SellByDate.ToString("ddd d MMM yyyy, HH:mm") UTC</div>

                        @if (canTransact && isSignedIn)
                        {
                            <form class="bid-form" method="get" action="/Bid">
                                <input type="hidden" name="listingId" value="@listing.Id">
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <label class="visually-hidden" for="bidAmount">Your bid</label>
                                    <input id="bidAmount" class="form-control" type="number" name="amount"
                                           min="@minNextBid" step="@increment" value="@minNextBid" inputmode="numeric" required>
                                </div>
                                <button class="btn" type="submit"><i class="bi bi-hammer" aria-hidden="true"></i>Place bid</button>
                            </form>
                            <div class="bid-hint">Minimum bid €@minNextBid (increment €@increment). Full refund if you are outbid.</div>
                            <div class="quick-bids">
                                @for (var k = 0; k < 3; k++)
                                {
                                    var quick = minNextBid + k * increment;
                                    if (quick < listing.DesiredPrice)
                                    {
                                        <button class="btn btn-sm" type="button" onclick="document.getElementById('bidAmount').value = @quick">€@quick</button>
                                    }
                                }
                            </div>
                        }
                        else if (canTransact)
                        {
                            <a class="btn w-100" style="background:var(--mg-sun-400);color:var(--mg-stone-900);font-weight:700" href="@loginUrl">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Log in to place a bid
                            </a>
                        }
                    </div>
                }
                else if (isAvailable)
                {
                    <div class="price-block">
                        <div class="label">Price</div>
                        <div class="amount tabular">€@listing.DesiredPrice.ToString("N0")</div>
                        <div class="sub">
                            @if (listing.AuctionStartDate > now)
                            {
                                @:Buy now · auction from @listing.AuctionStartDate.Value.ToString("d MMM"), starting at €@listing.MinPrice.ToString("N0")
                            }
                            else
                            {
                                @:Fixed price · available until @listing.SellByDate.ToString("d MMM yyyy")
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="price-block">
                        <div class="label">@(listing.Status == ListingStatus.Sold ? "Sold for" : "Last price")</div>
                        <div class="amount tabular @(listing.Status == ListingStatus.Sold ? "" : "is-sold")">€@listing.CurrentPrice.ToString("N0")</div>
                        <div class="sub">@(listing.Status == ListingStatus.Sold ? "Sold" : "Ended") · @listing.SellByDate.ToString("d MMM yyyy")</div>
                    </div>
                    <div class="sold-notice mt-3">
                        <i class="bi bi-bag-check" aria-hidden="true"></i>
                        <span>@(listing.Status == ListingStatus.Sold ? "This item has found a new home." : "This listing is no longer available.") Similar items are still on the site.</span>
                    </div>
                    @if (listing.Category != null)
                    {
                        <div class="d-grid gap-2 mt-3">
                            <a class="btn btn-primary" href="/Category/@listing.Category.Slug"><i class="bi bi-grid" aria-hidden="true"></i>More in @listing.Category.Name</a>
                        </div>
                    }
                }

                @if (isAvailable && isShowcase)
                {
                    <div class="showcase-notice mt-3">
                        <span class="icon-wrap"><i class="bi bi-eye" aria-hidden="true"></i></span>
                        <div>
                            <strong>Showcase listing</strong>
                            <p>This item stays on the site permanently so every visitor sees the same example. Buying, bidding and offers are switched off.</p>
                        </div>
                    </div>
                    <div class="d-grid gap-2 mt-3">
                        <a class="btn btn-primary" href="/Listings"><i class="bi bi-search" aria-hidden="true"></i>Try a live listing</a>
                        @if (!isSignedIn)
                        {
                            <a class="btn btn-secondary" href="/Identity/Account/Login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Log in with a demo account</a>
                        }
                    </div>
                }
                else if (isAvailable && Model.IsOwner)
                {
                    <div class="d-grid gap-2 mt-3">
                        <a href="/Listings/Edit/@listing.Id" class="btn btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i>Edit listing</a>
                        @if (Model.BidCount == 0)
                        {
                            <form method="post" asp-page-handler="Delete" id="deleteListingForm"></form>
                            <button type="button" class="btn btn-outline-danger"
                                    onclick="confirmDeleteListing(@System.Text.Json.JsonSerializer.Serialize(listing.Title))">
                                <i class="bi bi-trash" aria-hidden="true"></i>Delete listing
                            </button>
                        }
                    </div>
                }
                else if (isAvailable && isSignedIn && !Model.HasProfile)
                {
                    <p class="text-muted small mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Admin accounts cannot make purchases. Use a regular buyer account.</p>
                }
                else if (isAvailable && seller?.StripeOnboardingComplete != true)
                {
                    <p class="text-muted small mt-3 mb-0"><i class="bi bi-clock me-1"></i>Payments are not set up by the seller yet. Check back soon.</p>
                }
                else if (canTransact)
                {
                    @if (isAuction)
                    {
                        <div class="or-sep">or skip the auction</div>
                    }
                    <div class="d-flex align-items-center justify-content-between gap-3 @(isAuction ? "" : "mt-3")">
                        @if (isAuction)
                        {
                            <div class="price-block">
                                <div class="label">Buy now</div>
                                <div class="fw-bold" style="font-family:var(--mg-font-display); font-size:1.75rem; font-weight:900">€@listing.DesiredPrice.ToString("N0")</div>
                            </div>
                        }
                        @if (isSignedIn)
                        {
                            <form method="post" asp-page-handler="BuyNow" class="flex-grow-1">
                                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-cart3" aria-hidden="true"></i>Buy now@(isAuction ? "" : $" for €{listing.DesiredPrice:N0}")</button>
                            </form>
                        }
                        else
                        {
                            <a href="@loginUrl" class="btn btn-primary btn-lg flex-grow-1"><i class="bi bi-cart3" aria-hidden="true"></i>Buy now@(isAuction ? "" : $" for €{listing.DesiredPrice:N0}")</a>
                        }
                    </div>

                    @if (isActive)
                    {
                        @if (!isSignedIn)
                        {
                            <a href="@loginUrl" class="btn btn-outline-primary w-100 mt-2"><i class="bi bi-tag" aria-hidden="true"></i>Make an offer</a>
                        }
                        else if (Model.ActiveOffer == null)
                        {
                            <button class="btn btn-outline-primary w-100 mt-2" type="button" data-bs-toggle="collapse" data-bs-target="#offerForm" aria-expanded="false" aria-controls="offerForm">
                                <i class="bi bi-tag" aria-hidden="true"></i>Make an offer
                            </button>
                            <div class="collapse" id="offerForm">
                                <form method="post" asp-page-handler="MakeOffer" class="mt-3 p-3 rounded-3" style="background:var(--mg-stone-50); border:1px solid var(--mg-border)">
                                    <input type="hidden" name="id" value="@listing.Id" />
                                    <label class="form-label" for="offerAmount">Your offer</label>
                                    <div class="d-flex gap-2">
                                        <div class="input-group">
                                            <span class="input-group-text">€</span>
                                            <input id="offerAmount" type="number" name="OfferAmount" class="form-control"
                                                   min="1" max="@((int)listing.DesiredPrice - 1)" step="1" inputmode="numeric" placeholder="Below €@listing.DesiredPrice.ToString("N0")" required />
                                        </div>
                                        <button type="submit" class="btn btn-accent">Send</button>
                                    </div>
                                    <div class="form-text">@sellerName has 24 hours to accept or decline. If someone buys the item first, the offer is cancelled.</div>
                                </form>
                            </div>
                        }
                        else if (Model.ActiveOffer.Status == PriceOfferStatus.Pending)
                        {
                            <div class="offer-card is-pending mt-3">
                                <div class="offer-body">
                                    <div>
                                        <span class="status-badge status-offer-pending"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Offer sent</span>
                                        <div class="offer-price mt-2">€@Model.ActiveOffer.Amount.ToString("N0")</div>
                                        <div class="small text-muted">Waiting for the seller · expires @Model.ActiveOffer.ExpiresAt.ToString("d MMM, HH:mm") UTC</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.ActiveOffer.Status == PriceOfferStatus.Accepted)
                        {
                            <div class="offer-card is-accepted mt-3">
                                <div class="offer-body">
                                    <div>
                                        <span class="status-badge status-offer-accepted"><i class="bi bi-check-circle" aria-hidden="true"></i>Offer accepted</span>
                                        <div class="offer-price mt-2">€@Model.ActiveOffer.Amount.ToString("N0")</div>
                                        <div class="small text-muted">Open the chat in Messages to complete your purchase.</div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (Model.SellerHasMoreListings)
                        {
                            <a href="/BundleOffer/@listing.SellerId" class="btn btn-secondary w-100 mt-2"><i class="bi bi-collection" aria-hidden="true"></i>Make a bundle offer</a>
                        }
                    }

                    <p class="small text-muted mt-3 mb-0 d-flex gap-2"><i class="bi bi-shield-check" aria-hidden="true"></i>Payment held in escrow until you confirm receipt.</p>
                }
            </div>

            @if (seller != null)
            {
                <div class="mt-3">
                    <div class="buy-panel">
                        <div class="seller-mini">
                            @if (!string.IsNullOrEmpty(seller.AvatarUrl))
                            {
                                <img src="@seller.AvatarUrl" alt="" class="avatar avatar-lg" style="width:56px; height:56px; object-fit:cover;">
                            }
                            else
                            {
                                <span class="avatar avatar-lg" style="width:56px; height:56px; font-size:1.125rem">@sellerInitials</span>
                            }
                            <div class="flex-grow-1">
                                <a class="name" href="/Seller/@seller.Id">@sellerName</a>
                                <div><partial name="_StarRating" model="@((seller.Rating, seller.TotalReviews))" /></div>
                                <div class="meta">@seller.TotalSales @(seller.TotalSales == 1 ? "sale" : "sales") · Member since @seller.CreatedAt.ToString("MMM yyyy")</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-secondary btn-sm flex-fill" href="/Seller/@seller.Id"><i class="bi bi-shop" aria-hidden="true"></i>Seller profile</a>
                        </div>
                    </div>
                </div>
            }
        </aside>

        <div class="listing-details">
            <div class="info-card">
                <h2>Description</h2>
                @if (!string.IsNullOrEmpty(listing.Description))
                {
                    <p class="mb-3" style="white-space: pre-line;">@listing.Description</p>
                }
                <dl class="mb-0">
                    <div class="kv"><dt>Condition</dt><dd>@condition</dd></div>
                    <div class="kv"><dt>Category</dt><dd>@listing.Category?.Name</dd></div>
                    <div class="kv"><dt>Must go before</dt><dd>@listing.SellByDate.ToString("d MMM yyyy")</dd></div>
                    @if (isShowcase)
                    {
                        <div class="kv"><dt>Listing type</dt><dd>Showcase (read-only demo)</dd></div>
                    }
                </dl>
            </div>

            @if (Model.BidCount > 0)
            {
                var bids = listing.Bids.OrderByDescending(b => b.Amount).ToList();
                <div class="mt-3">
                    <div class="info-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2 class="mb-0">Bid history</h2>
                            <span class="text-muted small">@bids.Count @(bids.Count == 1 ? "bid" : "bids") · starting price €@listing.MinPrice.ToString("N0")</span>
                        </div>
                        <ul class="bid-list mt-2">
                            @for (var b = 0; b < bids.Count; b++)
                            {
                                var bid = bids[b];
                                var bidder = bid.Bidder?.DisplayName ?? "Bidder";
                                var bidderInitials = string.Concat(bidder.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                                <li class="bid-item @(b == 0 ? "is-leading" : "")">
                                    <span class="avatar">@bidderInitials</span>
                                    <span>
                                        <span class="who">@bidder</span>
                                        @if (b == 0)
                                        {
                                            <span class="leading-tag">@(listing.Status == ListingStatus.Sold ? "Winner" : "Leading")</span>
                                        }
                                        <span class="when d-block">@bid.CreatedAt.ToString("d MMM, HH:mm")</span>
                                    </span>
                                    <span class="amt">€@bid.Amount.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="mt-3">
                <div class="info-card">
                    <h2>Pickup &amp; delivery</h2>
                    <ul class="safety-list">
                        <li><i class="bi bi-geo-alt" aria-hidden="true"></i><span><strong>@(listing.PickupCity ?? "Malta")</strong>. The exact address is shared after payment.</span></li>
                        <li><i class="bi bi-truck" aria-hidden="true"></i><span>MaltaPost tracked delivery</span></li>
                        <li><i class="bi bi-people" aria-hidden="true"></i><span>Or meet in person and confirm receipt in the app</span></li>
                        <li><i class="bi bi-shield-check" aria-hidden="true"></i><span>Escrow: @sellerName is paid only after you confirm you have the item</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script>
        // Live auction countdown. The server renders the initial values, so the numbers are
        // right without JavaScript too; at zero the page reloads to show the result.
        (function () {
            const box = document.querySelector('.countdown[data-ends-at]');
            if (!box) return;
            const end = new Date(box.dataset.endsAt).getTime();
            const pad = n => String(n).padStart(2, '0');
            const unit = name => box.querySelector('[data-unit="' + name + '"]');
            const [d, h, m, s] = ['d', 'h', 'm', 's'].map(unit);
            const tick = () => {
                const left = Math.max(0, end - Date.now());
                const total = Math.floor(left / 1000);
                d.textContent = String(Math.floor(total / 86400));
                h.textContent = pad(Math.floor(total % 86400 / 3600));
                m.textContent = pad(Math.floor(total % 3600 / 60));
                s.textContent = pad(total % 60);
                box.classList.toggle('is-urgent', left < 3600 * 1000);
                if (left === 0) { clearInterval(timer); setTimeout(() => location.reload(), 1500); }
            };
            const timer = setInterval(tick, 1000);
            tick();
        })();

        // Gallery thumbnails
        (function () {
            const thumbs = [...document.querySelectorAll('#thumbnailStrip .gallery-thumb')];
            const mainImg = document.getElementById('mainImage');
            if (!thumbs.length || !mainImg) return;
            let current = 0;
            window.goToImage = function (idx) {
                current = idx;
                mainImg.src = thumbs[idx].dataset.full;
                thumbs.forEach((t, i) => t.classList.toggle('active', i === idx));
            };
            document.addEventListener('keydown', e => {
                if (e.target.closest('input, textarea')) return;
                if (e.key === 'ArrowLeft') goToImage((current - 1 + thumbs.length) % thumbs.length);
                if (e.key === 'ArrowRight') goToImage((current + 1) % thumbs.length);
            });
        })();

        // Favourite toggle
        document.getElementById('favBtn')?.addEventListener('click', async function () {
            if (this.dataset.authenticated !== 'true') {
                window.location.href = this.dataset.loginUrl;
                return;
            }
            const btn = this;
            const token = document.querySelector('meta[name="request-verification-token"]')?.content ?? '';
            const res = await fetch('/Api/ToggleFavourite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `listingId=${btn.dataset.listingId}`
            });
            const data = await res.json();
            if (data.success) {
                const icon = btn.querySelector('i');
                btn.classList.toggle('is-active', data.isFavourited);
                icon.classList.toggle('bi-heart', !data.isFavourited);
                icon.classList.toggle('bi-heart-fill', data.isFavourited);
                btn.setAttribute('aria-label', data.isFavourited ? 'Remove from favourites' : 'Save to favourites');
            }
        });

        // Delete listing
        window.confirmDeleteListing = function (title) {
            Swal.fire({
                title: 'Delete listing?',
                text: title + ' will be permanently deleted.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#B42318',
                confirmButtonText: 'Yes, delete it',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then(result => {
                if (result.isConfirmed) document.getElementById('deleteListingForm').submit();
            });
        };
    </script>
}
