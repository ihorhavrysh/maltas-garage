@page
@model MaltasGarage.Web.Pages.Account.DeleteAccountModel
@{
    ViewData["Title"] = "Delete Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="text-center mb-4">
                <div class="text-danger mb-3" style="font-size: 3rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h1 class="fw-bold mb-1">Delete Account</h1>
                <p class="text-muted">This action is permanent and cannot be undone.</p>
            </div>

            @if (Model.Blockers.Any())
            {
                <div class="alert alert-warning mb-4">
                    <div class="fw-semibold mb-2">
                        <i class="bi bi-lock me-2"></i>You cannot delete your account right now:
                    </div>
                    <ul class="mb-0 ps-3">
                        @foreach (var blocker in Model.Blockers)
                        {
                            <li>@blocker</li>
                        }
                    </ul>
                </div>
            }

            <div class="card border-danger">
                <div class="card-header bg-danger text-white fw-semibold">
                    <i class="bi bi-trash me-2"></i>What will be deleted
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="py-2 border-bottom">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Your email address, password and login credentials
                        </li>
                        <li class="py-2 border-bottom">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Your profile (name, bio, location, avatar, phone number)
                        </li>
                        <li class="py-2 border-bottom">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            All your messages and conversations
                        </li>
                        <li class="py-2 border-bottom">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Your favourites and notification preferences
                        </li>
                        <li class="py-2 border-bottom">
                            <i class="bi bi-check-circle-fill text-danger me-2"></i>
                            Active listings (cancelled automatically)
                        </li>
                        <li class="py-2">
                            <i class="bi bi-info-circle-fill text-muted me-2"></i>
                            <span class="text-muted">Order history is kept for legal and financial record-keeping purposes, but shown as "Deleted User".</span>
                        </li>
                    </ul>
                </div>
            </div>

            @if (!Model.Blockers.Any())
            {
                <div class="card mt-4">
                    <div class="card-body">
                        <p class="text-muted mb-3">Enter your password to confirm you want to permanently delete your account.</p>
                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password *</label>
                                <input asp-for="Password" class="form-control" placeholder="Enter your current password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash me-2"></i>Delete My Account
                                </button>
                                <a href="/Account/Settings" class="btn btn-outline-secondary">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-4 text-center">
                    <a href="/Account/Settings" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to Settings
                    </a>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
