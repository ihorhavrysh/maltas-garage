@page
@model MaltasGarage.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <!-- Avatar with upload trigger -->
                    <div class="avatar-wrapper mb-3 position-relative mx-auto" style="width: 80px; height: 80px;">
                        @if (!string.IsNullOrEmpty(Model.Profile?.AvatarUrl))
                        {
                            <img id="avatarPreview" src="@Model.Profile.AvatarUrl" alt="Avatar"
                                 class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
                        }
                        else
                        {
                            <div id="avatarPreview" class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 80px; height: 80px; font-size: 2rem;">
                                <i class="bi bi-person"></i>
                            </div>
                        }
                        <label for="AvatarFile" class="avatar-edit-btn" title="Change photo">
                            <i class="bi bi-camera-fill"></i>
                        </label>
                    </div>

                    <h6 class="mb-1">@(Model.Profile?.DisplayName ?? "User")</h6>
                    <p class="text-muted small mb-3">Member since @Model.Profile?.CreatedAt.ToString("MMM yyyy")</p>

                    <div class="d-flex justify-content-center gap-4 text-center">
                        <div>
                            <div class="fw-bold">@Model.Profile?.TotalSales</div>
                            <small class="text-muted">Sales</small>
                        </div>
                        <div>
                            <div class="fw-bold">@Model.Profile?.Rating.ToString("0.0")</div>
                            <small class="text-muted">Rating</small>
                        </div>
                        <div>
                            <div class="fw-bold">@Model.Profile?.TotalReviews</div>
                            <small class="text-muted">Reviews</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="list-group mt-3">
                <a href="/Account/Profile" class="list-group-item list-group-item-action active">
                    <i class="bi bi-person me-2"></i>Profile
                </a>
                <a href="/Account/MyListings" class="list-group-item list-group-item-action">
                    <i class="bi bi-collection me-2"></i>My Listings
                </a>
                <a href="/Account/Sales" class="list-group-item list-group-item-action">
                    <i class="bi bi-graph-up me-2"></i>My Sales
                </a>
                <a href="/Orders" class="list-group-item list-group-item-action">
                    <i class="bi bi-bag me-2"></i>My Orders
                </a>
                <a href="/Account/Favourites" class="list-group-item list-group-item-action">
                    <i class="bi bi-heart me-2"></i>Favourites
                </a>
                <a href="/Account/Settings" class="list-group-item list-group-item-action">
                    <i class="bi bi-gear me-2"></i>Settings
                </a>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            @if (!Model.EmailConfirmed)
            {
                <div class="alert alert-warning d-flex align-items-start gap-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
                    <div class="flex-grow-1">
                        <strong>Your email address is not confirmed.</strong>
                        <p class="mb-2 mt-1 small">If you lose access to your account, you won't be able to reset your password without a confirmed email.</p>
                        <form method="post">
                            <button type="submit" asp-page-handler="ResendConfirmation" class="btn btn-secondary btn-sm">
                                <i class="bi bi-envelope me-1"></i>Resend confirmation email
                            </button>
                        </form>
                    </div>
                </div>
            }

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="profileTabs">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-profile">
                        <i class="bi bi-pencil me-1"></i>Edit Profile
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviews" id="reviews-tab-btn">
                        <i class="bi bi-star me-1"></i>Reviews
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Edit Profile Tab -->
                <div class="tab-pane fade show active" id="tab-profile">
                    <div class="card">
                        <div class="card-body">
                            @if (Model.SuccessMessage != null)
                            {
                                <p class="text-success mb-3"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</p>
                            }
                            @if (Model.ErrorMessage != null)
                            {
                                <p class="text-danger mb-3"><i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage</p>
                            }

                            <form method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <input type="file" id="AvatarFile" name="AvatarFile"
                                       accept="image/jpeg,image/png,image/webp"
                                       class="d-none"
                                       onchange="previewAvatar(this)">

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.DisplayName" class="form-label">Display Name</label>
                                        <input asp-for="Input.DisplayName" class="form-control" />
                                        <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Location" class="form-label">Location</label>
                                        <select asp-for="Input.Location" class="form-select" id="locationSelect">
                                            <option value="">Select location...</option>
                                            <optgroup label="Malta">
                                                <option>Attard</option>
                                                <option>Balzan</option>
                                                <option>Birkirkara</option>
                                                <option>Birzebbuga</option>
                                                <option>Birgu (Vittoriosa)</option>
                                                <option>Bormla (Cospicua)</option>
                                                <option>Dingli</option>
                                                <option>Fgura</option>
                                                <option>Floriana</option>
                                                <option>Ghaxaq</option>
                                                <option>Gharghur</option>
                                                <option>Gudja</option>
                                                <option>Gzira</option>
                                                <option>Hamrun</option>
                                                <option>Iklin</option>
                                                <option>Isla (Senglea)</option>
                                                <option>Kalkara</option>
                                                <option>Kirkop</option>
                                                <option>Lija</option>
                                                <option>Luqa</option>
                                                <option>Marsa</option>
                                                <option>Marsascala</option>
                                                <option>Marsaxlokk</option>
                                                <option>Mdina</option>
                                                <option>Mellieha</option>
                                                <option>Mgarr</option>
                                                <option>Mqabba</option>
                                                <option>Msida</option>
                                                <option>Mosta</option>
                                                <option>Mtarfa</option>
                                                <option>Naxxar</option>
                                                <option>Paola</option>
                                                <option>Pembroke</option>
                                                <option>Pieta</option>
                                                <option>Qormi</option>
                                                <option>Qrendi</option>
                                                <option>Rabat</option>
                                                <option>Safi</option>
                                                <option>San Gwann</option>
                                                <option>Santa Lucija</option>
                                                <option>Santa Venera</option>
                                                <option>Siggiewi</option>
                                                <option>Sliema</option>
                                                <option>St Julian's</option>
                                                <option>St Paul's Bay</option>
                                                <option>Swieqi</option>
                                                <option>Ta' Xbiex</option>
                                                <option>Tarxien</option>
                                                <option>Valletta</option>
                                                <option>Xghajra</option>
                                                <option>Zabbar</option>
                                                <option>Zebbug</option>
                                                <option>Zejtun</option>
                                                <option>Zurrieq</option>
                                            </optgroup>
                                            <optgroup label="Gozo">
                                                <option>Fontana</option>
                                                <option>Gharb</option>
                                                <option>Ghajnsielem</option>
                                                <option>Kercem</option>
                                                <option>Munxar</option>
                                                <option>Nadur</option>
                                                <option>Qala</option>
                                                <option>San Lawrenz</option>
                                                <option>Sannat</option>
                                                <option>Victoria</option>
                                                <option>Xaghra</option>
                                                <option>Zebbug (Gozo)</option>
                                            </optgroup>
                                            <option value="Other">Other...</option>
                                        </select>
                                        <input type="text" id="locationOtherInput" class="form-control mt-2 d-none"
                                               placeholder="Enter your location..." maxlength="100">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
                                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+356 9999 9999" />
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Bio" class="form-label">Bio</label>
                                    <textarea asp-for="Input.Bio" class="form-control" rows="3" placeholder="Tell buyers a bit about yourself..."></textarea>
                                    <span asp-validation-for="Input.Bio" class="text-danger small"></span>
                                </div>

                                <div class="d-flex align-items-center gap-3">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-lg me-2"></i>Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Stripe Connect -->
                    <div class="mt-4">
                        <h6 class="fw-semibold mb-2"><i class="bi bi-credit-card me-2"></i>Payment Settings</h6>
                        @if (Model.Profile?.StripeOnboardingComplete == true)
                        {
                            <p class="text-primary mb-2"><i class="bi bi-check-circle me-2"></i>Your Stripe account is connected. You can receive payments.</p>
                            <form method="post" asp-page-handler="StripeDashboard" target="_blank">
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-box-arrow-up-right me-2"></i>Access Stripe Dashboard
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-2">Connect your Stripe account to receive payments when you sell items.</p>
                            <a href="/Account/ConnectStripe" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-link-45deg me-2"></i>Connect Stripe
                            </a>
                        }
                    </div>
                </div>

                <!-- Reviews Tab -->
                <div class="tab-pane fade" id="tab-reviews">
                    <div class="card">
                        <div class="card-body p-0">
                            @if (Model.Reviews.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var review in Model.Reviews)
                                    {
                                        <div class="list-group-item px-4 py-3">
                                            <div class="d-flex align-items-start gap-3">
                                                @if (!string.IsNullOrEmpty(review.FromUserAvatarUrl))
                                                {
                                                    <img src="@review.FromUserAvatarUrl" alt="@review.FromUserName"
                                                         class="rounded-circle flex-shrink-0"
                                                         style="width: 40px; height: 40px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                                         style="width: 40px; height: 40px;">
                                                        <i class="bi bi-person"></i>
                                                    </div>
                                                }
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <div>
                                                            <span class="fw-semibold me-2">@review.FromUserName</span>
                                                            @for (int i = 1; i <= 5; i++)
                                                            {
                                                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted") small"></i>
                                                            }
                                                        </div>
                                                        <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(review.Comment))
                                                    {
                                                        <p class="mb-0 text-muted">@review.Comment</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="mb-0 text-muted fst-italic">No comment left.</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-star fs-1 d-block mb-3"></i>
                                    <p class="mb-1">No reviews yet</p>
                                    <small>Reviews appear here after buyers complete their orders and rate you.</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #profileTabs .nav-link {
        color: var(--color-text);
    }
    #profileTabs .nav-link.active {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
        border-top-color: transparent;
        border-left-color: transparent;
        border-right-color: transparent;
    }
    #profileTabs .nav-link:hover:not(.active) { color: var(--color-primary); }
    .avatar-wrapper { cursor: pointer; }
    .avatar-edit-btn {
        position: absolute;
        bottom: 0; right: 0;
        width: 30px; height: 30px;
        background: var(--color-primary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        cursor: pointer;
        border: 2px solid white;
    }
    .avatar-edit-btn:hover { background: var(--color-primary-dark); }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewAvatar(input) {
            if (!input.files || !input.files[0]) return;
            const reader = new FileReader();
            reader.onload = e => {
                const preview = document.getElementById('avatarPreview');
                if (preview.tagName === 'IMG') {
                    preview.src = e.target.result;
                } else {
                    const img = document.createElement('img');
                    img.id = 'avatarPreview';
                    img.src = e.target.result;
                    img.className = 'rounded-circle';
                    img.style = 'width:80px;height:80px;object-fit:cover;';
                    preview.replaceWith(img);
                }
            };
            reader.readAsDataURL(input.files[0]);
        }

        if (location.hash === '#reviews')
            bootstrap.Tab.getOrCreateInstance(document.getElementById('reviews-tab-btn')).show();

        // Location "Other" handling
        const locationSelect = document.getElementById('locationSelect');
        const locationOtherInput = document.getElementById('locationOtherInput');

        if (locationSelect) {
            // Restore custom value if saved location isn't in the list
            const savedLocation = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Profile?.Location ?? ""));
            const knownValues = Array.from(locationSelect.options).map(o => o.value);
            if (savedLocation && !knownValues.includes(savedLocation)) {
                locationSelect.value = 'Other';
                locationOtherInput.value = savedLocation;
                locationOtherInput.classList.remove('d-none');
            }

            locationSelect.addEventListener('change', function () {
                locationOtherInput.classList.toggle('d-none', this.value !== 'Other');
                if (this.value === 'Other') locationOtherInput.focus();
            });

            locationSelect.closest('form').addEventListener('submit', function () {
                if (locationSelect.value === 'Other' && locationOtherInput.value.trim()) {
                    const val = locationOtherInput.value.trim();
                    const opt = new Option(val, val, true, true);
                    locationSelect.add(opt);
                    locationSelect.value = val;
                }
            });
        }
    </script>
}
