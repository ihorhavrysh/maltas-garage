@page
@model MaltasGarage.Web.Pages.Account.StripeReturnModel
@{
    ViewData["Title"] = "Stripe Setup Complete";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            @if (Model.IsReady)
            {
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                <h2 class="mt-3">You're all set!</h2>
                <p class="text-muted">Your Stripe account is connected. You can now sell on Malta's Garage.</p>
                <a href="/Account/Profile" class="btn btn-primary mt-2">Go to Profile</a>
            }
            else
            {
                <i class="bi bi-clock text-warning" style="font-size: 4rem;"></i>
                <h2 class="mt-3">Setup Incomplete</h2>
                <p class="text-muted">Your Stripe account setup isn't finished yet. Please complete all required steps.</p>
                <a href="/Account/ConnectStripe" class="btn btn-primary mt-2">Continue Setup</a>
            }
        </div>
    </div>
</div>
