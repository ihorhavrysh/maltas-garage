@page
@model MaltasGarage.Web.Pages.Account.ConnectStripeModel
@{
    ViewData["Title"] = "Connect Stripe";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            @if (Model.IsConnected)
            {
                <div class="text-center">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h2 class="mt-3">You're all set!</h2>
                    <p class="text-muted">Your account is connected and ready to receive payments.</p>
                    <a href="/Account/Profile" class="btn btn-primary mt-2">Back to Profile</a>
                </div>
                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-2">View your earnings, payouts and payout settings:</p>
                    <form method="post" asp-page-handler="Dashboard">
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Access Stripe Dashboard
                        </button>
                    </form>
                </div>
            }
            else
            {
                <!-- Header -->
                <div class="text-center mb-4">
                    <i class="bi bi-bank text-primary" style="font-size: 3.5rem;"></i>
                    <h2 class="mt-3 fw-bold">Set up your payouts</h2>
                    <p class="text-muted">To receive money from your sales, we need to verify your identity and link your bank account. This is handled securely by <strong>Stripe</strong> - the same payment platform used by Amazon, Airbnb, and thousands of other marketplaces.</p>
                </div>

                <!-- What to expect -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-list-check me-2 text-primary"></i>What you'll be asked for</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-person-badge text-muted mt-1"></i>
                                    <div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">Your full name & date of birth</div>
                                        <div class="text-muted" style="font-size:0.8rem;">For identity verification</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-house text-muted mt-1"></i>
                                    <div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">Your home address</div>
                                        <div class="text-muted" style="font-size:0.8rem;">Required by EU regulations</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-credit-card-2-front text-muted mt-1"></i>
                                    <div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">ID or passport photo</div>
                                        <div class="text-muted" style="font-size:0.8rem;">A photo upload via phone or webcam</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-piggy-bank text-muted mt-1"></i>
                                    <div>
                                        <div class="fw-semibold" style="font-size:0.9rem;">Your IBAN</div>
                                        <div class="text-muted" style="font-size:0.8rem;">Where your sales money gets sent</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Time + reassurance -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row g-3 text-center">
                            <div class="col-4">
                                <i class="bi bi-clock text-primary fs-4"></i>
                                <div class="fw-semibold mt-1" style="font-size:0.9rem;">~5 minutes</div>
                                <div class="text-muted" style="font-size:0.8rem;">To complete setup</div>
                            </div>
                            <div class="col-4">
                                <i class="bi bi-shield-lock text-primary fs-4"></i>
                                <div class="fw-semibold mt-1" style="font-size:0.9rem;">Bank-level security</div>
                                <div class="text-muted" style="font-size:0.8rem;">Your data goes to Stripe, not us</div>
                            </div>
                            <div class="col-4">
                                <i class="bi bi-cash-coin text-primary fs-4"></i>
                                <div class="fw-semibold mt-1" style="font-size:0.9rem;">No monthly fees</div>
                                <div class="text-muted" style="font-size:0.8rem;">10% only on successful sales</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (TempData["Error"] != null)
                {
                    <p class="text-center text-danger mb-3">
                        <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
                    </p>
                }

                <div class="text-center">
                    <form method="post">
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-arrow-right-circle me-2"></i>Continue to Stripe
                        </button>
                    </form>
                    <p class="text-muted mt-3" style="font-size:0.8rem;">
                        You'll be redirected to Stripe's secure site. Once done, you'll come back here automatically.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
