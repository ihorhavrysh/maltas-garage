@page "{slug}"
@model MaltasGarage.Web.Pages.CategoryModel
@{
    var categoryName = Model.Category?.Name ?? "Items";
    var categorySlug = Model.Category?.Slug ?? "";
    ViewData["Title"]       = $"Buy & Sell Second Hand {categoryName} in Malta";
    ViewData["Description"] = $"Browse {Model.TotalCount} second-hand {categoryName.ToLower()} for sale in Malta.";
    ViewData["Canonical"]   = Site.Absolute($"/Category/{categorySlug}");
}

<!-- Category Hero -->
<section class="py-4 bg-light-custom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/Categories">Categories</a></li>
                <li class="breadcrumb-item active">@Model.Category?.Name</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center">
            @{ var catIcon = Model.Category?.IconClass ?? ""; var catIconFull = catIcon.Contains(' ') ? catIcon : "bi " + catIcon; }
            <i class="@catIconFull text-primary me-3" style="font-size: 2.5rem;"></i>
            <div>
                <h1 class="mb-0">@Model.Category?.Name</h1>
                <p class="text-muted mb-0">@Model.TotalCount items available</p>
            </div>
        </div>
    </div>
</section>

<!-- Subcategories (if any) -->
@if (Model.Subcategories.Any())
{
    <section class="py-3 border-bottom">
        <div class="container">
            <div class="d-flex flex-wrap gap-2">
                <a href="/Category/@Model.Category?.Slug" class="btn @(Model.SelectedSubcategory == null ? "btn-primary" : "btn-outline-primary") btn-sm">
                    All
                </a>
                @foreach (var sub in Model.Subcategories)
                {
                    <a href="/Category/@Model.Category?.Slug?sub=@sub.Slug"
                       class="btn @(Model.SelectedSubcategory == sub.Slug ? "btn-primary" : "btn-outline-primary") btn-sm">
                        @sub.Name
                    </a>
                }
            </div>
        </div>
    </section>
}

<!-- Filters -->
<section class="py-3">
    <div class="container">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="sub" value="@Model.SelectedSubcategory" />

            <div class="col-md-4">
                <label class="form-label">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="categorySearchInput" name="q" class="form-control" placeholder="Search in @Model.Category?.Name..." value="@Model.Q" autocomplete="off" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label">Price Range</label>
                <div class="input-group">
                    <span class="input-group-text">€</span>
                    <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@Model.MinPrice" />
                    <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@Model.MaxPrice" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Sort by</label>
                <select name="sort" class="form-select">
                    <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                    <option value="price-asc" selected="@(Model.Sort == "price-asc")">Price: Low to High</option>
                    <option value="price-desc" selected="@(Model.Sort == "price-desc")">Price: High to Low</option>
                    <option value="ending" selected="@(Model.Sort == "ending")">Ending Soon</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Condition</label>
                <select name="condition" class="form-select @(!string.IsNullOrEmpty(Model.Condition) ? "border-primary" : "")">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.Condition))">All</option>
                    <option value="new" selected="@(Model.Condition == "new")">New</option>
                    <option value="used" selected="@(Model.Condition == "used")">Used</option>
                </select>
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</section>

<!-- Listings Grid -->
<section class="py-4">
    <div class="container">
        @if (Model.Listings.Any())
        {
            <div class="row g-4">
                @foreach (var listing in Model.Listings)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="_ListingCard" model="listing" />
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                var _pq   = !string.IsNullOrEmpty(Model.Q) ? $"&q={Uri.EscapeDataString(Model.Q)}" : "";
                var _psub = !string.IsNullOrEmpty(Model.SelectedSubcategory) ? $"&sub={Model.SelectedSubcategory}" : "";
                var _pmin = Model.MinPrice.HasValue ? $"&minPrice={Model.MinPrice}" : "";
                var _pmax = Model.MaxPrice.HasValue ? $"&maxPrice={Model.MaxPrice}" : "";
                var _pcond = !string.IsNullOrEmpty(Model.Condition) ? $"&condition={Model.Condition}" : "";
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?pageNum=@i&sort=@Model.Sort@_pq@_psub@_pmin@_pmax@_pcond">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3">No items found</h4>
                <p class="text-muted">Be the first to list something in this category!</p>
                <a href="/Listings/Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Create Listing
                </a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        initSearchAutocomplete(document.getElementById('categorySearchInput'), {
            categoryId: '@Model.Category?.Id'
        });
    </script>
}
