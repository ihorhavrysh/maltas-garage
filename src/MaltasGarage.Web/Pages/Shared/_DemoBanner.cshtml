@using MaltasGarage.Web.Filters
@inject Microsoft.Extensions.Options.IOptions<MaltasGarage.Application.Common.Models.DemoSettings> DemoOptions
@if (DemoOptions.Value.Enabled)
{
    var notice = TempData[DemoGuardPageFilter.NoticeKey] as string;

    <div class="demo-banner text-center small py-2 px-3" role="note">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Demo project.</strong>
        Payments run in Stripe test mode (card 4242 4242 4242 4242, any future date, any CVC).
        Data may be reset.
        <a href="/Identity/Account/Login" class="ms-1">Demo accounts</a>
    </div>

    @if (!string.IsNullOrEmpty(notice))
    {
        <div class="container mt-3">
            <div class="alert alert-warning alert-dismissible fade show mb-0" role="alert">
                <i class="bi bi-shield-lock me-1"></i>@notice
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
}
