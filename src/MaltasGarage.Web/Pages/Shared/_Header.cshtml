@using Microsoft.AspNetCore.Identity
@using MaltasGarage.Application.Common.Interfaces
@using MaltasGarage.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject SignInManager<IdentityUser> SignInManager
@inject ICurrentUserService CurrentUserService
@inject ApplicationDbContext DbContext
@{
    int unreadChats = 0;
    int unreadSystem = 0;
    string? headerName = null;
    bool hasProfile = false;
    bool isSignedIn = SignInManager.IsSignedIn(User);
    bool isAdminOrManager = User.IsStaff();
    string query = Context.Request.Query["q"].ToString();

    if (isSignedIn && !string.IsNullOrEmpty(CurrentUserService.UserId))
    {
        // One round trip for the name and both counters: this runs on every page
        var header = await DbContext.UserProfiles
            .Where(p => p.UserId == CurrentUserService.UserId)
            .Select(p => new
            {
                p.DisplayName,
                UnreadChats = DbContext.ChatMessages.Count(m =>
                    m.FromUserId != p.Id && !m.IsRead &&
                    (m.Conversation.BuyerId == p.Id || m.Conversation.SellerId == p.Id)),
                UnreadSystem = DbContext.SystemMessages.Count(m => m.UserId == p.Id && !m.IsRead)
            })
            .FirstOrDefaultAsync();

        if (header != null)
        {
            hasProfile = true;
            headerName = header.DisplayName;
            unreadChats = header.UnreadChats;
            unreadSystem = header.UnreadSystem;
        }
    }

    var displayName = headerName ?? "Account";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    static string Badge(int count) => count > 9 ? "9+" : count.ToString();
}

<header class="site-header">
    <div class="container">
        <div class="header-inner">
            <a class="brand" href="/">
                <img class="brand-mark" src="~/images/logo-mark.svg" alt="">
                <span class="brand-name">Malta's <span>Garage</span></span>
            </a>

            <form class="header-search" role="search" action="/Listings" method="get">
                <label class="visually-hidden" for="q-top">Search listings</label>
                <span class="search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input id="q-top" class="form-control" type="search" name="q" value="@query" placeholder="Search bikes, lamps, cameras..." autocomplete="off">
                <button class="btn btn-primary btn-sm" type="submit">Search</button>
            </form>

            <nav class="header-nav" aria-label="Main">
                <a class="nav-link-plain hide-md" href="/HowItWorks">How it works</a>

                @if (!isSignedIn)
                {
                    <a class="btn btn-ghost btn-sm hide-md" href="/Identity/Account/Login">Log in</a>
                    <a class="btn btn-primary btn-sm" href="/Identity/Account/Register">Sign up</a>
                }
                else if (hasProfile && !isAdminOrManager)
                {
                    <a class="btn btn-outline-primary btn-sm hide-md" href="/Listings/Create">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>Sell an item
                    </a>
                    <a class="icon-btn" href="/Messages" aria-label="Messages@(unreadChats > 0 ? $", {unreadChats} unread" : "")">
                        <i class="bi bi-chat" aria-hidden="true"></i>
                        @if (unreadChats > 0)
                        {
                            <span class="notif-badge">@Badge(unreadChats)</span>
                        }
                    </a>
                    <a class="icon-btn" href="/Messages" aria-label="Notifications@(unreadSystem > 0 ? $", {unreadSystem} unread" : "")">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        @if (unreadSystem > 0)
                        {
                            <span class="notif-badge">@Badge(unreadSystem)</span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="icon-btn account-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                            <span class="avatar">@initials</span>
                            <i class="bi bi-chevron-down small" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">@displayName</h6></li>
                            <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i>My profile</a></li>
                            <li><a class="dropdown-item" href="/Account/MyListings"><i class="bi bi-collection me-2"></i>My listings</a></li>
                            <li><a class="dropdown-item" href="/Orders"><i class="bi bi-bag me-2"></i>My orders</a></li>
                            <li><a class="dropdown-item" href="/Account/Sales"><i class="bi bi-graph-up me-2"></i>My sales</a></li>
                            <li><a class="dropdown-item" href="/Account/Favourites"><i class="bi bi-heart me-2"></i>Favourites</a></li>
                            <li><a class="dropdown-item d-lg-none" href="/Listings/Create"><i class="bi bi-plus-lg me-2"></i>Sell an item</a></li>
                            <li><a class="dropdown-item d-lg-none" href="/HowItWorks"><i class="bi bi-question-circle me-2"></i>How it works</a></li>
                            <li><a class="dropdown-item" href="/Account/Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    @if (isAdminOrManager)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="/Admin"><i class="bi bi-shield-check" aria-hidden="true"></i>Admin</a>
                    }
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
                    </form>
                }

                @if (!isSignedIn)
                {
                    <div class="dropdown d-lg-none">
                        <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open menu">
                            <i class="bi bi-list" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/HowItWorks">How it works</a></li>
                            <li><a class="dropdown-item" href="/Identity/Account/Login">Log in</a></li>
                        </ul>
                    </div>
                }
            </nav>
        </div>

        <div class="header-mobile-search">
            <form class="header-search" role="search" action="/Listings" method="get">
                <label class="visually-hidden" for="q-mob">Search listings</label>
                <span class="search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <input id="q-mob" class="form-control" type="search" name="q" value="@query" placeholder="Search bikes, lamps, cameras..." autocomplete="off">
                <button class="btn btn-primary btn-sm" type="submit">Search</button>
            </form>
        </div>
    </div>
</header>
