@using MaltasGarage.Domain.Enums
@model MaltasGarage.Web.Pages.CategoryModel.ListingCardViewModel
@{
    var now = DateTime.UtcNow;
    var remaining = Model.SellByDate - now;
    var isAuction = Model.Status == ListingStatus.AuctionPhase;
    var isScheduled = Model.Status == ListingStatus.Active && Model.AuctionStartDate > now;
    var stateClass = Model.Status switch
    {
        ListingStatus.Sold => "is-sold",
        ListingStatus.Expired => "is-expired",
        _ => ""
    };

    // One status per card, most important first: Sold > Expired > Showcase > Live / Ending soon
    // > Scheduled auction > Buy now only
    string badgeClass, badgeText, badgeIcon;
    if (Model.Status == ListingStatus.Sold) { badgeClass = "status-sold"; badgeText = "Sold"; badgeIcon = "bi-bag-check"; }
    else if (Model.Status == ListingStatus.Expired) { badgeClass = "status-expired"; badgeText = "Expired"; badgeIcon = "bi-clock-history"; }
    else if (Model.IsShowcase) { badgeClass = "status-showcase"; badgeText = "Showcase"; badgeIcon = "bi-eye"; }
    else if (isAuction && remaining.TotalHours <= 24) { badgeClass = "status-ending"; badgeText = remaining.TotalHours >= 1 ? $"Ends in {(int)remaining.TotalHours}h" : "Ending soon"; badgeIcon = "bi-fire"; }
    else if (isAuction) { badgeClass = "status-live"; badgeText = $"Live · {(int)remaining.TotalDays}d {remaining.Hours}h"; badgeIcon = ""; }
    else if (isScheduled) { badgeClass = "status-scheduled"; badgeText = $"Auction {Model.AuctionStartDate:d MMM} · from €{Model.MinPrice:N0}"; badgeIcon = "bi-calendar-event"; }
    else { badgeClass = "status-buynow"; badgeText = "Buy now only"; badgeIcon = "bi-tag"; }

    var priceNote = Model.Status switch
    {
        ListingStatus.Sold => "Sold",
        ListingStatus.Expired => "Ended",
        _ when Model.IsShowcase => "Showcase item",
        ListingStatus.AuctionPhase => Model.BidCount > 0
            ? $"Current bid · {Model.BidCount} {(Model.BidCount == 1 ? "bid" : "bids")}"
            : "Starting bid",
        _ => "Buy now"
    };
}

<article class="listing-card @stateClass">
    <div class="card-media">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="" loading="lazy">
        }
        else
        {
            <div class="d-flex h-100 align-items-center justify-content-center text-muted"><i class="bi bi-image fs-1" aria-hidden="true"></i></div>
        }
        <div class="card-badges">
            <span class="status-badge @badgeClass">
                @if (badgeClass == "status-live")
                {
                    <span class="pulse"></span>
                }
                else
                {
                    <i class="bi @badgeIcon" aria-hidden="true"></i>
                }
                @badgeText
            </span>
            @if (Model.IsNew)
            {
                <span class="status-badge status-new"><i class="bi bi-stars" aria-hidden="true"></i>New</span>
            }
        </div>
    </div>
    <div class="card-body">
        <div class="price-row">
            <span class="price">€@Model.CurrentPrice.ToString("N0")</span>
            <span class="price-note">@priceNote</span>
        </div>
        <h3 class="card-title"><a href="/Listing/@Model.Id">@Model.Title</a></h3>
        <div class="card-meta">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <span>@(Model.City ?? "Malta")</span>
            <span class="dot"></span>
            <span>@(Model.IsNew ? "New" : "Used")</span>
        </div>
    </div>
</article>
