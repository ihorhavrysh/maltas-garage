@using MaltasGarage.Domain.Entities
@using MaltasGarage.Domain.Enums
@model Order

@{
    var isBundle = Model.IsBundleOrder;
    var thumb = isBundle
        ? null
        : (Model.Listing?.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.ThumbnailUrl
           ?? Model.Listing?.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.Url);
    var displayTitle = isBundle
        ? $"Bundle ({Model.Items.Count} items)"
        : (Model.Listing?.Title ?? "-");

    var (badgeClass, badgeText) = (Model.Status, Model.DeliveryMethod, Model.DeliveryMethodPending) switch
    {
        (OrderStatus.Pending,   _, _)                                   => ("bg-warning text-dark", "Awaiting Payment"),
        (OrderStatus.Paid,      _, true)                                => ("bg-warning text-dark", "Awaiting Delivery Choice"),
        (OrderStatus.Paid,      DeliveryMethod.MaltaPost,   false)      => ("bg-warning text-dark", "Ship Now"),
        (OrderStatus.Paid,      DeliveryMethod.HandToHand,  false)      => ("bg-warning text-dark", "Arrange Meetup"),
        (OrderStatus.Paid,      _, _)                                   => ("bg-warning text-dark", "Ship Now"),
        (OrderStatus.Shipped,   _, _)                                   => ("bg-info text-dark",    "Shipped - Awaiting Confirmation"),
        (OrderStatus.Delivered, _, _)                                   => ("bg-info text-dark",    "Delivered"),
        (OrderStatus.Completed, _, _)                                   => ("bg-primary",           "Completed"),
        (OrderStatus.Disputed,  _, _)                                   => ("bg-danger",            "Under Dispute"),
        (OrderStatus.Refunded,  _, _)                                   => ("bg-secondary",         "Refunded"),
        _                                                               => ("bg-secondary",         Model.Status.ToString())
    };

    var deliveryIcon = Model.DeliveryMethod == DeliveryMethod.HandToHand
        ? "bi-person-check"
        : "bi-envelope";
}

<div class="d-flex align-items-center gap-3 p-3 border-bottom">
    <!-- Thumbnail -->
    <div class="flex-shrink-0">
        @if (!string.IsNullOrEmpty(thumb))
        {
            <img src="@thumb" alt="@displayTitle"
                 style="width: 64px; height: 64px; object-fit: cover; border-radius: 8px;">
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center rounded"
                 style="width: 64px; height: 64px;">
                <i class="bi @(isBundle ? "bi-collection" : "bi-image") text-muted fs-4"></i>
            </div>
        }
    </div>

    <!-- Info -->
    <div class="flex-grow-1 min-width-0">
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge @badgeClass">@badgeText</span>
            <small class="text-muted">
                <i class="bi @deliveryIcon me-1"></i>@Model.DeliveryMethod.ToString().Replace("HandToHand", "Hand-to-Hand")
            </small>
        </div>
        <div class="fw-semibold text-truncate">@displayTitle</div>
        <small class="text-muted">
            Buyer: @(Model.Buyer?.DisplayName ?? "-") ·
            <span class="text-primary fw-semibold">€@Model.SellerPayout.ToString("N2") to you</span>
            <span class="text-muted">(€@Model.FinalPrice.ToString("N0") − €@Model.PlatformFee.ToString("N2") fee)</span>
            · @Model.CreatedAt.ToString("dd MMM yyyy")
        </small>
    </div>

    <!-- Action -->
    <div class="flex-shrink-0">
        <a href="/Orders/Details/@Model.Id" class="btn btn-sm btn-outline-primary">
            View
        </a>
    </div>
</div>
