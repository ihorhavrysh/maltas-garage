@page "{sellerId:guid}"
@model MaltasGarage.Web.Pages.BundleOfferModel
@{
    ViewData["Title"] = "Make a Bundle Offer";
}

<div class="container py-4" style="max-width: 760px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Seller/@Model.SellerId">@(Model.Seller?.DisplayName ?? "Seller")</a></li>
            <li class="breadcrumb-item active">Bundle Offer</li>
        </ol>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]</div>
    }

    <h4 class="mb-1"><i class="bi bi-collection me-2"></i>Make a Bundle Offer</h4>
    <p class="text-muted mb-4">Select items from @(Model.Seller?.DisplayName ?? "this seller") and name your price for the whole bundle.</p>

    @if (Model.ActiveOffer != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-clock me-2"></i>
            You already have an active bundle offer of <strong>€@Model.ActiveOffer.OfferAmount.ToString("N0")</strong> with this seller.
            Expires <strong>@Model.ActiveOffer.ExpiresAt.ToLocalTime().ToString("dd MMM, HH:mm")</strong>.
            <a href="/Messages?c=@Model.ActiveOffer.ConversationId" class="alert-link ms-2">View in chat</a>
        </div>
    }
    else
    {
        <div class="alert alert-light border mb-4" style="font-size: 0.9rem;">
            <i class="bi bi-info-circle text-info me-2"></i>
            Your offer will be sent to the seller. They can <strong>accept or decline</strong> the whole bundle.
            If accepted, you'll be able to complete the purchase in the chat.
            If any item is bought by someone else or goes to auction before the seller responds, the offer will be cancelled automatically.
            Offers expire after <strong>24 hours</strong>.
        </div>

        <form method="post">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">Select items</h6>
                    <small class="text-muted"><span id="selectedCount">0</span> selected</small>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var listing in Model.Listings)
                    {
                        var thumb = listing.Images.OrderBy(i => i.SortOrder).FirstOrDefault();
                        <label class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3"
                               style="cursor: pointer;">
                            <input type="checkbox" name="SelectedListings" value="@listing.Id"
                                   class="form-check-input flex-shrink-0 listing-checkbox"
                                   style="width: 1.2rem; height: 1.2rem;" />
                            <div class="flex-shrink-0">
                                @if (thumb != null)
                                {
                                    <img src="@(thumb.ThumbnailUrl ?? thumb.Url)" alt="@listing.Title"
                                         style="width: 52px; height: 52px; object-fit: cover; border-radius: 6px;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded"
                                         style="width: 52px; height: 52px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <a href="/Listing/@listing.Id" target="_blank"
                                   class="fw-semibold text-primary text-decoration-none"
                                   onclick="event.stopPropagation()">
                                    @listing.Title <i class="bi bi-box-arrow-up-right ms-1" style="font-size: 0.7rem; opacity: 0.5;"></i>
                                </a>
                                <small class="text-muted d-block">€@listing.DesiredPrice.ToString("N0")</small>
                            </div>
                            <div class="flex-shrink-0 fw-semibold text-primary listing-price"
                                 data-price="@listing.DesiredPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                €@listing.DesiredPrice.ToString("N0")
                            </div>
                        </label>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Total listed price</span>
                        <span class="fw-semibold" id="totalListed">€0</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="text-muted flex-shrink-0">Your offer</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" name="OfferAmount" id="offerAmount" class="form-control"
                                   min="1" step="1" placeholder="e.g. 80" required />
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">Must be less than the total listed price</small>
                </div>
            </div>

            <button type="submit" class="btn btn-outline-blue w-100" id="submitBtn" disabled>
                <i class="bi bi-collection me-2"></i>Send Bundle Offer
            </button>
        </form>
    }
</div>

@section Scripts {
    <script>
        const checkboxes = document.querySelectorAll('.listing-checkbox');
        const totalEl    = document.getElementById('totalListed');
        const countEl    = document.getElementById('selectedCount');
        const offerInput = document.getElementById('offerAmount');
        const submitBtn  = document.getElementById('submitBtn');

        function update() {
            let total = 0, count = 0;
            checkboxes.forEach(cb => {
                if (cb.checked) {
                    total += parseFloat(cb.closest('label').querySelector('.listing-price').dataset.price);
                    count++;
                }
            });
            totalEl.textContent = '€' + Math.round(total).toLocaleString();
            countEl.textContent = count;
            offerInput.max = total - 1;
            submitBtn.disabled = count < 2 || !offerInput.value || parseFloat(offerInput.value) <= 0;
        }

        checkboxes.forEach(cb => cb.addEventListener('change', update));
        offerInput?.addEventListener('input', update);
    </script>
}
