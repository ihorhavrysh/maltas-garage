@section Scripts {
    <script>
        function showTab(which) {
            const btn = document.getElementById(which + '-tab-btn');
            if (btn) {
                const tab = new bootstrap.Tab(btn);
                tab.show();
            }
        }

        // If URL has ?tab=seller, auto-switch
        const params = new URLSearchParams(location.search);
        if (params.get('tab') === 'seller') showTab('seller');
    </script>
}
