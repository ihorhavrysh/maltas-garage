@page
@model LoginModel
@using MaltasGarage.Infrastructure.Data.Seed
@inject Microsoft.Extensions.Options.IOptions<MaltasGarage.Application.Common.Models.DemoSettings> DemoOptions
@{
    ViewData["Title"] = "Sign In";
    var demoAccounts = new[]
    {
        ("Buyer", DemoAccounts.BuyerEmail, "bi-bag"),
        ("Seller", DemoAccounts.SellerEmail, "bi-shop"),
        ("Admin", DemoAccounts.AdminEmail, "bi-shield-lock")
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-circle text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-2">Welcome Back</h2>
                        <p class="text-muted">Sign in to your account</p>
                    </div>

                    @if (DemoOptions.Value.Enabled)
                    {
                        <div class="border rounded p-3 mb-4 bg-light">
                            <div class="small fw-semibold mb-2">Try a demo account (password <code>@DemoAccounts.Password</code>)</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var (role, email, icon) in demoAccounts)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm demo-login"
                                            data-email="@email" data-password="@DemoAccounts.Password">
                                        <i class="bi @icon me-1"></i>@role
                                    </button>
                                }
                            </div>
                        </div>
                        <script>
                            document.querySelectorAll('.demo-login').forEach(b => b.addEventListener('click', () => {
                                document.getElementById('Input_Email').value = b.dataset.email;
                                document.getElementById('Input_Password').value = b.dataset.password;
                                document.getElementById('loginForm').submit();
                            }));
                        </script>
                    }

                    <form id="loginForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control" placeholder="your@email.com" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 d-flex justify-content-between align-items-center">
                            <div class="form-check mb-0">
                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                <label asp-for="Input.RememberMe" class="form-check-label">Remember me</label>
                            </div>
                            <a asp-page="./ForgotPassword" class="small">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>

                    <hr class="my-4">

                    <p class="text-center mb-0">
                        Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
