@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    @if (Model.Confirmed)
                    {
                        <i class="bi bi-envelope-check text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Email Confirmed!</h2>
                        <p class="text-muted mt-2">
                            Your email address has been confirmed. Your account is now fully secured.
                        </p>
                        <a href="/Account/Profile" class="btn btn-primary mt-2">
                            <i class="bi bi-person me-2"></i>Complete Your Profile
                        </a>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-circle text-danger" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Confirmation Failed</h2>
                        <p class="text-muted mt-2">
                            This confirmation link is invalid or has expired.
                            You can request a new one from your profile page.
                        </p>
                        <a href="/Account/Profile" class="btn btn-outline-primary mt-2">
                            <i class="bi bi-arrow-repeat me-2"></i>Go to Profile
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
