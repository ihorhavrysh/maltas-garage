@page
@model RegisterModel
@inject Microsoft.Extensions.Options.IOptions<MaltasGarage.Application.Common.Models.DemoSettings> DemoOptions
@{
    ViewData["Title"] = "Create account";
}

<div class="container py-5">
    <div class="auth-wrap">
        <div class="auth-side d-none d-lg-flex">
            <img src="/images/Hero/hero.svg" alt="">
            <div class="position-relative bg-white rounded-4 p-3 shadow-sm" style="max-width: 360px">
                <div class="fw-bold mb-1"><i class="bi bi-shield-check me-1" aria-hidden="true"></i>Escrow on every order</div>
                <div class="small text-muted">Pay by card, the seller is paid after you confirm you have the item.</div>
            </div>
        </div>

        <div class="auth-form">
            <h1 class="mb-1">Create your account</h1>
            <p class="text-muted mb-4">Free to join. Start selling in a couple of minutes.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="col-12 alert alert-danger mb-0" role="alert"></div>

                <div class="col-12">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="col-sm-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="col-12 form-text mt-1">At least 6 characters, with a number and a lowercase letter.</div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.AgreeToTerms" class="form-check-input" type="checkbox" id="agreeToTerms" />
                        <label class="form-check-label" for="agreeToTerms">
                            I agree to the <a href="/Terms" target="_blank">terms</a> and <a href="/Privacy" target="_blank">privacy policy</a>
                        </label>
                    </div>
                    <span asp-validation-for="Input.AgreeToTerms" class="text-danger small"></span>
                </div>

                <div class="col-12 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Create account</button>
                </div>
            </form>

            @if (DemoOptions.Value.Enabled)
            {
                <div class="alert alert-warning mt-4 mb-0 d-flex gap-2">
                    <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                    <span>Just looking around? <a href="/Identity/Account/Login" class="fw-bold" style="color: inherit">Use a demo account</a> instead, no sign-up needed.</span>
                </div>
            }

            <p class="text-center mt-4 mb-0">
                Already have an account? <a class="fw-bold" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
