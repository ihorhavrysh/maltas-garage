@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-check-circle text-primary" style="font-size: 3rem;"></i>
                    <h2 class="mt-3">Password Reset</h2>
                    <p class="text-muted mt-2">
                        Your password has been reset successfully. You can now sign in with your new password.
                    </p>
                    <a asp-page="./Login" class="btn btn-primary mt-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
