@page
@model MaltasGarage.Web.Areas.Admin.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="fw-bold mb-0">Dashboard</h4>
    @if (Model.CanResetDemo)
    {
        <form method="post" asp-page-handler="ResetDemo"
              onsubmit="return confirm('Delete all visitor data and reseed the demo?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset demo now
            </button>
        </form>
    }
</div>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:48px;height:48px;">
                    <i class="bi bi-people text-primary fs-5"></i>
                </div>
                <div>
                    <div class="h4 fw-bold mb-0">@Model.TotalUsers</div>
                    <small class="text-muted">Total Users</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:48px;height:48px;">
                    <i class="bi bi-grid text-primary fs-5"></i>
                </div>
                <div>
                    <div class="h4 fw-bold mb-0">@Model.ActiveListings</div>
                    <small class="text-muted">Active Listings</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:48px;height:48px;">
                    <i class="bi bi-bag text-primary fs-5"></i>
                </div>
                <div>
                    <div class="h4 fw-bold mb-0">@Model.TotalOrders</div>
                    <small class="text-muted">Total Orders</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:48px;height:48px;">
                    <i class="bi bi-currency-euro text-primary fs-5"></i>
                </div>
                <div>
                    <div class="h4 fw-bold mb-0">€@Model.TotalRevenue.ToString("N0")</div>
                    <small class="text-muted">Platform Revenue</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="card">
    <div class="card-header fw-semibold">Recent Orders</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th>Buyer</th>
                    <th>Seller</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td class="text-truncate" style="max-width:180px;">@order.Title</td>
                        <td>@order.BuyerName</td>
                        <td>@order.SellerName</td>
                        <td>€@order.FinalPrice.ToString("N0")</td>
                        <td>
                            <span class="fw-semibold @(order.Status == "Disputed" ? "text-danger" : order.Status == "Completed" ? "text-success" : "text-secondary")">
                                @order.Status
                            </span>
                        </td>
                        <td class="text-muted small">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td><a href="/Orders/Details/@order.Id" target="_blank" class="btn btn-sm btn-outline-secondary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
