@page
@model MaltasGarage.Web.Areas.Admin.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="admin-topbar">
    <div>
        <h1 class="mb-0">Dashboard</h1>
        <p class="text-muted mb-0">@DateTime.UtcNow.ToString("dddd, d MMM yyyy")</p>
    </div>
    @if (Model.CanResetDemo)
    {
        <form method="post" asp-page-handler="ResetDemo"
              onsubmit="return confirm('Delete all visitor data and reseed the demo?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Reset demo now
            </button>
        </form>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="stat-grid mb-4">
    <div class="stat-card">
        <div class="stat-label">Active listings<i class="bi bi-grid" aria-hidden="true"></i></div>
        <div class="stat-value">@Model.ActiveListings</div>
        <div class="stat-delta">Live or open for offers</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Orders<i class="bi bi-bag" aria-hidden="true"></i></div>
        <div class="stat-value">@Model.TotalOrders</div>
        <div class="stat-delta">@Model.TotalUsers registered users</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Platform revenue<i class="bi bi-currency-euro" aria-hidden="true"></i></div>
        <div class="stat-value">€@Model.TotalRevenue.ToString("N0")</div>
        <div class="stat-delta">Fees on completed orders</div>
    </div>
    <div class="stat-card @(Model.OpenDisputes > 0 ? "is-alert" : "")">
        <div class="stat-label">Open disputes<i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
        <div class="stat-value">@Model.OpenDisputes</div>
        <div class="stat-delta" style="@(Model.OpenDisputes > 0 ? "color: var(--mg-coral-700)" : "")">
            @(Model.OpenDisputes > 0 ? "Needs review" : "All clear")
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">
        <h2>Recent orders</h2>
        @if (Model.OpenDisputes > 0)
        {
            <a class="section-link small" href="/Admin/Disputes">Review disputes <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        }
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Item</th>
                    <th scope="col">Buyer</th>
                    <th scope="col">Seller</th>
                    <th scope="col">Total</th>
                    <th scope="col">Status</th>
                    <th scope="col">Date</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    var badge = order.Status switch
                    {
                        "Completed" => "status-offer-accepted",
                        "Disputed" => "status-ending",
                        "Shipped" => "status-scheduled",
                        "Refunded" or "Cancelled" => "status-expired",
                        _ => "status-buynow"
                    };
                    <tr>
                        <td class="text-truncate fw-semibold" style="max-width:220px;">@order.Title</td>
                        <td>@order.BuyerName</td>
                        <td>@order.SellerName</td>
                        <td class="tabular fw-semibold">€@order.FinalPrice.ToString("N2")</td>
                        <td><span class="status-badge @badge">@order.Status</span></td>
                        <td class="text-muted">@order.CreatedAt.ToString("d MMM")</td>
                        <td><a href="/Orders/Details/@order.Id" target="_blank" class="btn btn-secondary btn-sm">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
