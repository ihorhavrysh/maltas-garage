@page
@model MaltasGarage.Web.Areas.Admin.Pages.Users.IndexModel
@{ ViewData["Title"] = "Users"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">Users</h4>
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm"
               placeholder="Search name or email…" style="width:220px;">
        <button class="btn btn-sm btn-outline-secondary">Search</button>
    </form>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Sales</th>
                    <th>Rating</th>
                    <th>Stripe</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr class="@(user.IsBanned ? "table-danger" : "")">
                        <td>
                            <a href="/Seller/@user.ProfileId" target="_blank" class="fw-semibold text-decoration-none">
                                @(user.DisplayName ?? "-")
                            </a>
                        </td>
                        <td class="text-muted small">@user.Email</td>
                        <td class="text-muted small">@user.JoinedDate.ToString("dd MMM yyyy")</td>
                        <td>@user.TotalSales</td>
                        <td>
                            @if (user.Rating > 0)
                            {
                                <span><i class="bi bi-star-fill text-warning"></i> @user.Rating.ToString("N1")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (user.StripeConnected)
                            {
                                <span class="fw-semibold text-success">Connected</span>
                            }
                            else
                            {
                                <span class="fw-semibold text-secondary">Not connected</span>
                            }
                        </td>
                        <td>
                            @if (user.IsBanned)
                            {
                                <span class="fw-semibold text-danger">Banned</span>
                            }
                            else
                            {
                                <span class="fw-semibold text-success">Active</span>
                            }
                        </td>
                        <td class="d-flex gap-1 flex-wrap">
                            @if (user.IsBanned)
                            {
                                <form method="post" asp-page-handler="Unban" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button class="btn btn-sm btn-outline-success">Unban</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Ban" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Ban this user?')">Ban</button>
                                </form>
                            }
                            @* Values travel as HTML-encoded data attributes, never as JavaScript source *@
                            <button type="button" class="btn btn-sm btn-outline-primary js-email-user"
                                    data-user-id="@user.UserId" data-email="@user.Email" data-name="@user.DisplayName">
                                <i class="bi bi-envelope"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Email Modal -->
<div class="modal fade" id="emailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="SendEmail">
                <div class="modal-header">
                    <h5 class="modal-title">Send Email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="emailUserId" />
                    <div class="mb-3">
                        <label class="form-label text-muted small">To</label>
                        <p class="mb-0 fw-semibold" id="emailToDisplay"></p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="emailSubject">Subject</label>
                        <input type="text" class="form-control" id="emailSubject" name="subject" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="emailMessage">Message</label>
                        <textarea class="form-control" id="emailMessage" name="message" rows="6" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i>Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (TempData["EmailSent"] != null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show" role="alert">
            <div class="toast-header">
                <i class="bi bi-check-circle text-success me-2"></i>
                <strong class="me-auto">Email sent</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">@TempData["EmailSent"]</div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openEmailModal(userId, email, name) {
            document.getElementById('emailUserId').value = userId;
            document.getElementById('emailToDisplay').textContent = name ? name + ' <' + email + '>' : email;
            document.getElementById('emailSubject').value = '';
            document.getElementById('emailMessage').value = '';
            new bootstrap.Modal(document.getElementById('emailModal')).show();
        }

        document.querySelectorAll('.js-email-user').forEach(button =>
            button.addEventListener('click', () =>
                openEmailModal(button.dataset.userId, button.dataset.email, button.dataset.name)));
    </script>
}
