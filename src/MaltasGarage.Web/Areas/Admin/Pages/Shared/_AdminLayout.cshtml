@using Microsoft.EntityFrameworkCore
@inject MaltasGarage.Infrastructure.Data.ApplicationDbContext DbContext
@{
    var openDisputeCount = await DbContext.Disputes
        .CountAsync(d => d.Status == DisputeStatus.Open || d.Status == DisputeStatus.UnderReview);
    var active = ViewData["ActivePage"]?.ToString();
    var isAdmin = User.IsInRole("Admin");

    string NavClass(string page) => active == page ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - @ViewData["Title"] - Malta's Garage</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Nunito:wght@700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_DemoBanner" />

    <div class="admin-shell">
        <aside class="admin-sidebar">
            <a class="brand" href="/Admin">
                <img class="brand-mark" src="~/images/logo-mark.svg" alt="">
                <span class="brand-name">Malta's <span>Garage</span></span>
            </a>
            <div class="small text-uppercase fw-bold mb-2" style="letter-spacing: .08em; color: #B3AA9C">Admin</div>
            <nav aria-label="Admin">
                <ul class="admin-nav">
                    @if (isAdmin)
                    {
                        <li><a href="/Admin" class="@NavClass("Dashboard")" aria-current="@(active == "Dashboard" ? "page" : null)"><i class="bi bi-speedometer2" aria-hidden="true"></i>Dashboard</a></li>
                    }
                    <li>
                        <a href="/Admin/Disputes" class="@NavClass("Disputes")" aria-current="@(active == "Disputes" ? "page" : null)">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>Disputes
                            @if (openDisputeCount > 0)
                            {
                                <span class="count">@openDisputeCount</span>
                            }
                        </a>
                    </li>
                    <li><a href="/Admin/Listings" class="@NavClass("Listings")" aria-current="@(active == "Listings" ? "page" : null)"><i class="bi bi-grid" aria-hidden="true"></i>Listings</a></li>
                    <li><a href="/Admin/Users" class="@NavClass("Users")" aria-current="@(active == "Users" ? "page" : null)"><i class="bi bi-people" aria-hidden="true"></i>Users</a></li>
                    @if (isAdmin)
                    {
                        <li><a href="/Admin/Staff" class="@NavClass("Staff")" aria-current="@(active == "Staff" ? "page" : null)"><i class="bi bi-person-gear" aria-hidden="true"></i>Staff</a></li>
                    }
                </ul>
            </nav>
            <hr style="border-color: rgba(255,255,255,.15)">
            <ul class="admin-nav">
                <li><a href="/"><i class="bi bi-arrow-left" aria-hidden="true"></i>Back to site</a></li>
            </ul>
        </aside>

        <main class="admin-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
