@page
@model MaltasGarage.Web.Areas.Admin.Pages.Disputes.IndexModel
@{ ViewData["Title"] = "Disputes"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="fw-bold mb-0">Disputes</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-3">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
}

<!-- Filter tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "open" ? "active" : "")" href="?filter=open">Open</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "resolved" ? "active" : "")" href="?filter=resolved">Resolved</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Filter == "all" ? "active" : "")" href="?filter=all">All</a>
    </li>
</ul>

@if (!Model.Disputes.Any())
{
    <div class="card">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-check-circle fs-1"></i>
            <p class="mt-2 mb-0">No disputes found.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order / Item</th>
                        <th>Buyer</th>
                        <th>Seller</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Opened</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Disputes)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-truncate" style="max-width:160px;">
                                    @d.Order?.Listing?.Title
                                </div>
                                <small class="text-muted">Order #@d.OrderId.ToString()[..8]</small>
                            </td>
                            <td>@(d.Order?.Buyer?.DisplayName ?? "-")</td>
                            <td>@(d.Order?.Seller?.DisplayName ?? "-")</td>
                            <td>
                                <small>
                                    @(d.Reason switch {
                                        MaltasGarage.Domain.Enums.DisputeReason.ItemNotReceived    => "Not received",
                                        MaltasGarage.Domain.Enums.DisputeReason.ItemNotAsDescribed => "Not as described",
                                        _ => "Other"
                                    })
                                </small>
                            </td>
                            <td>
                                <span class="fw-semibold @(d.Status == "Open" ? "text-danger" : d.Status == "UnderReview" ? "text-warning" : d.Status == "Resolved" ? "text-success" : "text-secondary")">
                                    @d.Status
                                </span>
                            </td>
                            <td class="text-muted small">@d.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a href="/Orders/DisputeView/@d.OrderId" target="_blank"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (d.Status == "Open")
                                    {
                                        <form method="post" asp-page-handler="MarkUnderReview" class="d-inline">
                                            <input type="hidden" name="disputeId" value="@d.Id" />
                                            <button class="btn btn-sm btn-outline-primary" title="Mark Under Review">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (d.Status == "Open" || d.Status == "UnderReview")
                                    {
                                        <button class="btn btn-sm btn-success" data-bs-toggle="modal"
                                                data-bs-target="#resolveModal-@d.Id" title="Resolve">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Resolve Modal -->
                                @if (d.Status == "Open" || d.Status == "UnderReview")
                                {
                                    <div class="modal fade" id="resolveModal-@d.Id" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Resolve Dispute</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form method="post" asp-page-handler="Resolve">
                                                    <div class="modal-body">
                                                        <p class="text-muted small mb-3">
                                                            <strong>@d.Order?.Listing?.Title</strong><br>
                                                            Buyer: @(d.Order?.Buyer?.DisplayName) ·
                                                            Seller: @(d.Order?.Seller?.DisplayName)
                                                        </p>
                                                        @if (!string.IsNullOrEmpty(d.Description))
                                                        {
                                                            <p class="small border rounded p-2 bg-light">@d.Description</p>
                                                        }
                                                        <input type="hidden" name="disputeId" value="@d.Id" />
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Resolution</label>
                                                            <select name="resolution" class="form-select" required
                                                                    onchange="togglePartialAmount(this, '@d.Id')">
                                                                <option value="RefundBuyer">Refund buyer (full refund)</option>
                                                                <option value="PaySeller">Release to seller</option>
                                                                <option value="PartialRefund">Partial refund to buyer</option>
                                                            </select>
                                                        </div>
                                                        <div class="mb-3 d-none" id="partialAmount-@d.Id">
                                                            <label class="form-label fw-semibold">Amount to refund to buyer (€)</label>
                                                            <input type="number" name="partialRefundAmount" class="form-control"
                                                                   min="0.01" max="@((d.Order?.FinalPrice ?? 0) - 0.01m)" step="0.01" placeholder="e.g. 25.00" />
                                                            <div class="form-text">
                                                                Refunded to buyer. Between €0.01 and €@(((d.Order?.FinalPrice ?? 0) - 0.01m).ToString("N2")) (order total: €@((d.Order?.FinalPrice ?? 0).ToString("N2"))). The remainder is paid out to the seller minus the platform fee.
                                                            </div>
                                                        </div>
                                                        <div class="mb-0">
                                                            <label class="form-label fw-semibold">Admin Notes <span class="text-muted fw-normal">(optional)</span></label>
                                                            <textarea name="adminNotes" class="form-control" rows="3" maxlength="2000"></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success">Resolve</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<script>
    function togglePartialAmount(select, disputeId) {
        const amountDiv = document.getElementById('partialAmount-' + disputeId);
        const input = amountDiv?.querySelector('input');
        if (select.value === 'PartialRefund') {
            amountDiv?.classList.remove('d-none');
            if (input) input.required = true;
        } else {
            amountDiv?.classList.add('d-none');
            if (input) input.required = false;
        }
    }
</script>
